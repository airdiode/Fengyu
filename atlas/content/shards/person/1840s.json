ce.省保名录"}]}],"relations":[{"type":"member_of","target":"group.huaqiao"}]},{"id":"person.smith","type":"person","labels":{"zh-Hans":"明恩溥","en":"Arthur Henderson Smith"},"time":{"kind":"interval","start":"1845-07-18","end":"1932-08-31","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"恩县"},"coord":[116.43,37.16]}]},"nationality":"us","summary":{"zh-Hans":"美国公理会传教士，1872 年来华，在山东恩县一带乡村传教近三十年；《中国人的性格》（1890）一书影响甚广。1906 年他面见罗斯福，推动美国退还部分庚子赔款用于办学，清华学堂即由此而来。"},"sources":[{"ref":"source.wiki.明恩溥"}],"tags":["外国人","美国","宗教","教育"],"relations":[{"type":"member_of","target":"group.chuanjiaoshi"}]},{"id":"person.yangyuechun","type":"person","labels":{"zh-Hans":"杨悦春"},"time":{"kind":"interval","start":"1841","end":"1891","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"敖汉旗"},"coord":[119.9,42.3]}]},"summary":{"zh-Hans":"直隶承德府建昌县人，原为敖汉旗贝子达克沁的佃户，后为金丹道大首领。1891 年 11 月聚众起事，攻入贝子府，旋被清军镇压，兵败后在天津被处决。"},"sources":[{"ref":"source.wiki.金丹道事件"}],"tags":["金丹道","民变"],"relations":[{"type":"member_of","target":"org.jindandao"},{"type":"custom:leader_of","target":"org.jindandao-qiyi"}]},{"id":"person.ma-jianzhong","type":"person","labels":{"zh-Hans":"马建忠","en":"Ma Jianzhong"},"time":{"kind":"interval","start":"1845","end":"1900","precision":"year"},"summary":{"zh-Hans":"镇江人。著《马氏文通》，中国第一部系统的汉语语法书。"},"sources":[{"ref":"source.wiki.马建忠"}],"tags":["思想","政治"],"space":{"points":[{"name":{"zh-Hans":"镇江"},"coord":[119.455,32.211]}]},"aliases":[{"zh-Hans":"眉叔"}],"relations":[{"type":"subordinate_of","target":"person.lihongzhang","note":{"zh-Hans":"李鸿章幕僚，随办洋务与对外交涉"},"source":["source.wiki.马建忠"]},{"type":"custom:sibling_of","target":"person.ma-xiangbo","note":{"zh-Hans":"CBDB 记「兄」"},"source":["source.cbdb"]},{"type":"member_of","target":"group.xuezhe"},{"type":"member_of","target":"group.yangwu"}]},{"id":"person.ma-xiangbo","type":"person","labels":{"zh-Hans":"马相伯","en":"Ma Xiangbo"},"time":{"kind":"interval","start":"1840","end":"1939","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"丹阳"},"coord":[119.575,31.995]}]},"summary":{"zh-Hans":"丹阳人。创办震旦学院与复旦公学。活跃于 1903—1939 年。"},"sources":[{"ref":"source.wiki.马相伯"}],"tags":["教育","思想"],"relations":[{"type":"member_of","target":"group.minguo-xuezhe"}]},{"id":"person.zheng-guanying","type":"person","labels":{"zh-Hans":"郑观应","en":"Zheng Guanying"},"time":{"kind":"interval","start":"1842","end":"1923","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"中山"},"coord":[113.35,22.533]}]},"summary":{"zh-Hans":"中山人。著《盛世危言》，倡「商战」与君主立宪。"},"sources":[{"ref":"source.wiki.鄭觀應"}],"tags":["思想","政治"],"visits":[{"kind":"residence","name":{"zh-Hans":"郑观应故居"},"address":{"zh-Hans":"广东省中山市三乡镇雍陌村西上二巷 6 号"},"note":{"zh-Hans":"第五批广东省保。清光绪二十九年（1903）郑观应兄弟为纪念父亲去世十周年而建，占地约 300 平方米，保持香山传统民居格局；郑观应 1842 年生于雍陌，著《盛世危言》，提出「商战」与立宪主张。村在三乡镇北，故居就在巷内。"},"status":"extant","sources":[{"ref":"source.省保名录"},{"ref":"source.web.郑观应故居"}],"since":"1903"}],"relations":[{"type":"subordinate_of","target":"person.lihongzhang","note":{"zh-Hans":"轮船招商局帮办，太古买办出身"},"source":["source.wiki.鄭觀應"]},{"type":"member_of","target":"group.yangwu"},{"type":"custom:director_of","target":"institution.shanghai-zhhibuju"}]},{"id":"person.huang-zunxian","type":"person","labels":{"zh-Hans":"黄遵宪","en":"Huang Zunxian"},"time":{"kind":"interval","start":"1848","end":"1905","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"嘉应直隶州"},"coord":[116.119,24.321]}]},"summary":{"zh-Hans":"嘉应直隶州人。驻日参赞，著《日本国志》，倡「诗界革命」。"},"sources":[{"ref":"source.wiki.黃遵憲"}],"tags":["外交","政治"],"aliases":[{"zh-Hans":"公度"},{"zh-Hans":"人境庐"}],"relations":[{"type":"custom:colleague_of","target":"person.zhang-yinhuai","note":{"zh-Hans":"CBDB 记「友」"},"source":["source.cbdb"]},{"type":"member_of","target":"org.qiangxuehui"}]},{"id":"person.chen-baochen","type":"person","labels":{"zh-Hans":"陈宝琛","en":"Chen Baochen"},"aliases":[{"zh-Hans":"陈伯潜"},{"zh-Hans":"陈弢庵"},{"zh-Hans":"伯潜"},{"zh-Hans":"敬嘉"},{"zh-Hans":"弢庵"},{"zh-Hans":"弢蓭"}],"time":{"kind":"interval","start":"1848","end":"1935","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"福州"},"coord":[119.34,25.99]}]},"summary":{"zh-Hans":"福建闽县螺洲人，字伯潜，号弢庵。同治进士，与张之洞等号为「清流」，中法战争后因荐人不察连降五级，归里二十五年，掌教鳌峰书院、创办全闽师范学堂（福建师范大学前身），并为福建第一条铁路赴南洋募捐。辛亥前夕起用，任宣统帝溥仪之师，是「末代帝师」；1935 年病逝北京，葬于福州马尾君竹村。 "},"visits":[{"kind":"residence","name":{"zh-Hans":"陈氏五楼（陈宝琛故居）"},"address":{"zh-Hans":"福建省福州市仓山区螺洲镇店前村"},"note":{"zh-Hans":"省级文物保护单位（第七批，名录作「螺洲陈氏五楼及宗祠」）。清末民初建的私家园林宅第，赐书楼、还读楼、沧趣楼、北望楼、晞楼五楼环池，历时 25 年建成；市级文保，今为螺洲古镇的核心景点，可与螺洲孔庙、吴石故居同走。"},"status":"extant","since":"1885","sources":[{"ref":"source.web.陈宝琛"},{"ref":"source.省保名录"}]},{"kind":"grave","name":{"zh-Hans":"陈宝琛墓"},"address":{"zh-Hans":"福建省福州市马尾区君竹村登龙岭"},"note":{"zh-Hans":"市级文物保护单位（福州市）。1935 年病逝北京后归葬于此，在马尾君竹村的山岭上；位置较偏、标识不多，建议先在村里问路。"},"status":"extant","since":"1935","sources":[{"ref":"source.web.陈宝琛"},{"ref":"source.web.陈宝琛墓"}]}],"sources":[{"ref":"source.web.陈宝琛"}],"tags":["政治","教育","福州"]},{"id":"person.zhang-renjun","type":"person","labels":{"zh-Hans":"张人骏","en":"Zhang Renjun"},"time":{"kind":"interval","start":"1846","end":"1927","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"丰润"},"coord":[118.16,39.83]}]},"summary":{"zh-Hans":"河北丰润人。两广总督、两江总督，清末重臣。"},"sources":[{"ref":"source.省保名录"}],"tags":["政治"],"visits":[{"kind":"grave","name":{"zh-Hans":"张人骏墓"},"address":{"zh-Hans":"河北省唐山市丰润区"},"note":{"zh-Hans":"省级文物保护单位（第五批）。张人骏墓在丰润区。"},"status":"extant","sources":[{"ref":"source.省保名录"}],"since":"1927"}],"aliases":[{"zh-Hans":"健庵"},{"zh-Hans":"千里"}]},{"id":"person.xu-jianyin","type":"person","labels":{"zh-Hans":"徐建寅","en":"Xu Jianyin"},"time":{"kind":"interval","start":"1845","end":"1901","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"无锡"},"coord":[120.3,31.57]}]},"summary":{"zh-Hans":"江苏无锡人。军工专家、徐寿之子，1901 年在汉阳试验无烟火药时殉职。"},"sources":[{"ref":"source.市县级名录"}],"tags":["科技"],"visits":[{"kind":"residence","name":{"zh-Hans":"徐建寅故居"},"address":{"zh-Hans":"江苏省无锡市山北街道会西社区杨巷 25 号"},"note":{"zh-Hans":"市级文物保护单位（无锡市保）。徐建寅故居在山北杨巷。"},"status":"extant","sources":[{"ref":"source.市县级名录"}]}]},{"id":"person.zhangpeilun","type":"person","labels":{"zh-Hans":"张佩纶"},"time":{"kind":"interval","start":"1848","end":"1903","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"丰润"},"coord":[118.16,39.83]}]},"roles":["翰林","会办福建海疆大臣"],"summary":{"zh-Hans":"清流名臣，中法战争马尾战败被革；后为李鸿章女婿。"},"sources":[{"ref":"source.《清史稿》"}],"tags":["人物","清朝","清流"],"visits":[{"kind":"grave","name":{"zh-Hans":"张佩纶墓"},"address":{"zh-Hans":"河北省唐山市丰润区王官营镇北黑山沟村"},"note":{"zh-Hans":"第五批河北省保（2008 年公布）。张佩纶 1903 年卒于南京，次年归葬丰润祖茔；墓在村北黑山沟，2015 年前后做过保护性修缮。丰润是张氏祖籍，与南京白下路的宅子正好一北一南。"},"status":"extant","sources":[{"ref":"source.省保名录"},{"ref":"source.web.张佩纶墓"}],"since":"1904"},{"kind":"residence","name":{"zh-Hans":"张佩纶宅（小姐楼）"},"address":{"zh-Hans":"江苏省南京市秦淮区白下路 273 号（江苏海院伯利兹科技园院内）"},"note":{"zh-Hans":"第七批江苏省保。俗称「小姐楼」，1912 年建的西式洋楼，原为清江南提督张云翼的张侯府，同治年间张佩纶购居；李鸿章把女儿李鞠耦嫁给他，夫妇住此，是张爱玲祖父母的宅第。张侯府老屋已无存，只余这一栋；2015 年大修后作办公用房，只能看外观。"},"status":"extant","sources":[{"ref":"source.省保名录"},{"ref":"source.web.张佩纶宅"}]}],"aliases":[{"zh-Hans":"幼樵"},{"zh-Hans":"幼桥"},{"zh-Hans":"蒉斋"},{"zh-Hans":"柑酒听鹂亭"},{"zh-Hans":"篑斋"},{"zh-Hans":"绳庵"}],"relations":[{"type":"custom:son_in_law_of","target":"person.lihongzhang","note":{"zh-Hans":"娶李鸿章女李菊藕"},"source":["source.《清史稿》"]},{"type":"custom:colleague_of","target":"person.zhangzhidong","note":{"zh-Hans":"CBDB 记「友」"},"source":["source.cbdb"]},{"type":"custom:colleague_of","target":"person.chen-baochen","note":{"zh-Hans":"CBDB 记「友」"},"source":["source.cbdb"]},{"type":"member_of","target":"group.qingliu"},{"type":"participant","target":"event.1884.马尾船政今福建福州马尾"}]},{"id":"person.jingyuanshan","type":"person","labels":{"zh-Hans":"经元善"},"time":{"kind":"interval","start":"1841","end":"1903","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上虞"},"coord":[120.87,30.03]}]},"roles":["电报局总办","慈善家"],"summary":{"zh-Hans":"上海电报局总办；1898 年创办经正女学。"},"sources":[{"ref":"source.wiki.经元善"}],"tags":["人物","商贾","教育","女性"],"relations":[{"type":"founded","target":"institution.jingzheng-nvxue"}]},{"id":"person.yechengzhong","type":"person","labels":{"zh-Hans":"叶澄衷"},"time":{"kind":"interval","start":"1840","end":"1899","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"镇海"},"coord":[121.72,29.95]}]},"roles":["五金商","实业家"],"summary":{"zh-Hans":"清末上海五金、火油业巨商；捐办澄衷学堂，资助贫寒子弟。"},"sources":[{"ref":"source.wiki.叶澄衷"}],"tags":["人物","商贾","教育"],"relations":[{"type":"member_of","target":"group.shijia"}]},{"id":"person.shoutai","type":"person","labels":{"zh-Hans":"尚泰"},"aliases":[{"zh-Hans":"尚泰王"},{"zh-Hans":"琉球藩王尚泰"}],"time":{"kind":"interval","start":"1843-08-03","end":"1901-08-19","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"首里"},"coord":[127.72,26.22]}]},"summary":{"zh-Hans":"琉球国第二尚氏第十九代国王、末代中山王。1848 年四岁即位，由王太妃摄政；1866 年受清廷最后一次册封（赵新、于光甲）。在位期间先后与美、法、荷签订修好条约。1872 年被日本改封「琉球藩王」，1879 年琉球处分后被迁往东京，1884 年封侯爵，1901 年卒于东京，归葬首里玉陵。"},"relations":[{"type":"custom:被废","target":"event.1872.那霸"},{"type":"custom:被废","target":"event.1879.那霸"},{"type":"participant","target":"event.1879.那霸"},{"type":"participant","target":"event.1872.那霸"}],"sources":[{"ref":"source.wiki.尚泰王"},{"ref":"source.《清末中琉日关系史研究》"}],"tags":["琉球","日本","国王"]},{"id":"person.林世功","type":"person","labels":{"zh-Hans":"林世功"},"aliases":[{"zh-Hans":"名城里之子亲云上"},{"zh-Hans":"官生新垣"}],"time":{"kind":"interval","start":"1842-02-03","end":"1880-11-20","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"久米村"},"coord":[127.68,26.21]}]},"summary":{"zh-Hans":"琉球久米村人，闽人三十六姓林氏后裔，国子监官生出身，归国后任中城王子尚典的讲解官。1876 年随向德宏秘密赴清求援。1880 年清廷将要在「分岛改约案」上签字时，他留下绝命诗二首，在总理各国事务衙门前自刎，清廷因此推翻和议、拒签条约。葬于通州张家湾琉球国墓地。"},"relations":[{"type":"custom:殉于","target":"event.1880.北京"},{"type":"participant","target":"event.1879.那霸"},{"type":"participant","target":"event.1880.北京"}],"sources":[{"ref":"source.wiki.林世功"},{"ref":"source.《清末中琉日关系史研究》"}],"tags":["琉球","外交"]},{"id":"person.hongtianguifu","type":"person","labels":{"zh-Hans":"洪天贵福"},"time":{"kind":"interval","start":"1849","end":"1864","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"南京"},"coord":[118.79,32.05]}]},"summary":{"zh-Hans":"洪秀全之子，太平天国幼天王；天京陷落后被俘，1864 年被处死。"},"sources":[{"ref":"source.《太平天国史》"}],"tags":["人物","太平天国","幼主"],"relations":[{"type":"participant","target":"event.1864.天京陷落南京"}]},{"id":"person.zhaoerfeng","type":"person","labels":{"zh-Hans":"赵尔丰"},"time":{"kind":"interval","start":"1845","end":"1911","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"成都"},"coord":[104.07,30.67]}]},"summary":{"zh-Hans":"汉军正蓝旗人，四川总督，镇压保路运动制造成都血案，后被处决。"},"sources":[{"ref":"source.《辛亥革命史》"}],"tags":["人物","清朝","四川"],"aliases":[{"zh-Hans":"季和"}],"relations":[{"type":"participant","target":"event.1911.成都"},{"type":"participant","target":"event.1911.各省光复"},{"type":"participant","target":"event.1911.成都血案"},{"type":"custom:suppressed_by","target":"org.baolu"}]},{"id":"person.bek-kuli","type":"person","labels":{"zh-Hans":"伯克·胡里","en":"Bek Kuli"},"time":{"kind":"interval","start":"1845","end":"1900","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"喀什噶尔"},"coord":[75.99,39.47]}]},"summary":{"zh-Hans":"阿古柏次子，随父入疆，1867 年任库车军事长官，1872 年镇压乌鲁木齐一带。1877 年阿古柏死后杀其弟海古拉自立，与清军作战失利，逃入俄国。"},"relations":[{"type":"participant","target":"org.zedeshar"},{"type":"member_of","target":"group.xinjiang-rebels"},{"type":"participant","target":"event.1877.喀什噶尔"},{"type":"participant","target":"event.1878.喀什噶尔今新疆喀什"}],"sources":[{"ref":"source.wiki.伯克·胡里"}],"tags":["新疆","阿古柏"]},{"id":"person.liu-jintang","type":"person","labels":{"zh-Hans":"刘锦棠","en":"Liu Jintang"},"aliases":[{"zh-Hans":"毅斋"},{"zh-Hans":"刘襄勤"}],"time":{"kind":"interval","start":"1844","end":"1894","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"湘乡"},"coord":[112.5,27.7]}]},"summary":{"zh-Hans":"湖南湘乡人，湘军出身，随左宗棠西征并任前敌统帅：1876 年克古牧地、乌鲁木齐，1877 年下达坂城、吐鲁番，1878 年收复喀什噶尔、和田。1884 年新疆建省后任第一任新疆巡抚，著有《刘襄勤公奏稿》。"},"relations":[{"type":"subordinate_of","target":"person.zuozongtang"},{"type":"member_of","target":"group.xiangjun"},{"type":"participant","target":"event.1876.乌鲁木齐"},{"type":"participant","target":"event.1884.乌鲁木齐"}],"sources":[{"ref":"source.wiki.刘锦棠"}],"tags":["湘军","新疆","左宗棠"]},{"id":"person.zhangbaixi","type":"person","labels":{"zh-Hans":"张百熙"},"time":{"kind":"interval","start":"1847","end":"1907","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"长沙"},"coord":[112.94,28.23]}]},"summary":{"zh-Hans":"湖南长沙人，京师大学堂管学大臣；主持癸卯学制与学堂章程。"},"sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["人物","清末新政","教育"],"visits":[{"kind":"grave","name":{"zh-Hans":"张百熙墓"},"address":{"zh-Hans":"湖南省长沙市长沙县春华镇百熙村泉井组"},"note":{"zh-Hans":"第九批湖南省保。张百熙（1847—1907）1902 年任管学大臣，主持京师大学堂、拟定壬寅与癸卯学制，是近代学制的奠基人之一；墓在春华镇百熙村泉井组，村名即由他而来。"},"status":"extant","sources":[{"ref":"source.省保名录"},{"ref":"source.web.张百熙墓"}]}],"aliases":[{"zh-Hans":"冶秋"},{"zh-Hans":"潜斋"},{"zh-Hans":"退思轩"}],"relations":[{"type":"participant","target":"event.1902.整顿学堂"},{"type":"participant","target":"event.1904.癸卯学制"},{"type":"participant","target":"event.1905.学部"}]},{"id":"person.yangnaiwu","type":"person","labels":{"zh-Hans":"杨乃武"},"aliases":[{"zh-Hans":"杨二爷"}],"time":{"kind":"interval","start":"1840","end":"1914","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"余杭"},"coord":[120.3,30.42]}]},"summary":{"zh-Hans":"浙江余杭人，同治十二年（1873）癸酉科举人，是当年余杭唯一中举者。因租住其家的豆腐店帮工葛品连暴亡，被知县刘锡彤定为「因奸谋命」主谋，刑求成招，判斩立决；系狱三年余，一条腿被打残。家人两度京控，加上《申报》持续报道与翁同龢等在刑部力争，1877 年开棺验尸后无罪开释，但仍杖一百、革去举人。出狱后以蚕桑为业，培育出「凤参牡丹杨乃武记」蚕种；曾赴上海向《申报》致谢，一度任该报编辑，后因编发失实报道得罪郭嵩焘而辞职。1914 年去世，年七十三。"},"sources":[{"ref":"source.web.申报与杨乃武案"}],"tags":["举人","冤案","余杭","晚清"]},{"id":"person.dechevrens","type":"person","labels":{"zh-Hans":"能恩斯"},"aliases":[{"zh-Hans":"Marc-Antoine Dechevrens"},{"zh-Hans":"德切夫伦斯"}],"time":{"kind":"interval","start":"1845-07-26","end":"1923-12-06","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"托内"},"coord":[6.2,46.2]}]},"summary":{"zh-Hans":"瑞士耶稣会神父、气象学家，生于日内瓦附近的托内。1873 年晋铎后派往上海徐家汇观象台，1875/1876 年起任台长，建立地磁观测，在 30 米高塔上装风速计测高空风。1879 年 7 月台风袭沪后写成《1879 年 7 月 31 日的台风》，是第一次较准确的台风预报；此后借沿海 50 个站点的电报网收集数据做预报。1887 年因病离开上海，1923 年卒。"},"sources":[{"ref":"source.wiki.能恩斯"},{"ref":"source.wiki.徐家汇观象台"}],"tags":["科技","气象","外国人","晚清"],"relations":[{"type":"participant","target":"event.1884.授时"}]},{"id":"person.major","type":"person","labels":{"zh-Hans":"美查"},"aliases":[{"zh-Hans":"安纳斯脱·美查"},{"zh-Hans":"Ernest Major"},{"zh-Hans":"爱内斯特·美查"}],"time":{"kind":"interval","start":"1841","end":"1908-03","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23],"role":"activity"},{"name":{"zh-Hans":"伦敦"},"coord":[-0.13,51.51],"role":"activity"}]},"nationality":"uk","summary":{"zh-Hans":"英国报人、实业家，申报与点石斋画报的创办人。1862 年与兄弟来上海做进出口贸易，后收购立德洋行的金银熔炼厂，改办美查制酸厂（1876 年改名江苏药水厂）。1872 年 4 月 30 日创办《申报》，1884 年创办《点石斋画报》，又办点石斋石印局、申昌书局，用活字印《古今图书集成》，并涉足制皂、火柴、榨油诸业；1889 年美查公司改为股份有限公司，同年他回英国，卒于伦敦。生年各源作 1830 年代或 1841 年，此处取后者。"},"sources":[{"ref":"source.wiki.美查"},{"ref":"source.wiki.申报"}],"tags":["报刊","英国","外国人","实业"],"relations":[{"type":"participant","target":"event.1872.申报"},{"type":"participant","target":"event.1884.点石斋"}]},{"id":"person.wu-youru","type":"person","labels":{"zh-Hans":"吴友如"},"aliases":[{"zh-Hans":"吴嘉猷"},{"zh-Hans":"吴猷"}],"time":{"kind":"interval","start":"1840","end":"1893","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"苏州"},"coord":[120.58,31.3]},{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23],"role":"activity"}]},"summary":{"zh-Hans":"名嘉猷，字友如，江苏苏州人，晚清画家，海派绘画早期代表。早年曾为宫廷画家，太平天国战事波及苏州后避居上海，成为《点石斋画报》的专用画师，以时事画著称，笔触细腻、人物生动，画作随画报风行一时。约生于 1840 年，1893 年卒。"},"sources":[{"ref":"source.wiki.吴友如"},{"ref":"source.wiki.点石斋画报"}],"tags":["美术","报刊","晚清"],"relations":[{"type":"participant","target":"event.1884.点石斋"}]}]}