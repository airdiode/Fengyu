{"key":"person/1800s","entities":[{"id":"person.duanhua","type":"person","labels":{"zh-Hans":"端华"},"time":{"kind":"interval","start":"1807","end":"1861","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清宗室，郑亲王；咸丰临终顾命八大臣之一，辛酉政变后被赐死。"},"sources":[{"ref":"source.《剑桥中国晚清史》"}],"tags":["人物","垂帘","宗室"],"relations":[{"type":"participant","target":"event.1861.北京"},{"type":"member_of","target":"group.qing-huanshi"}]},{"id":"person.ye-mingchen","type":"person","labels":{"zh-Hans":"叶名琛","en":"Ye Mingchen"},"aliases":[{"zh-Hans":"叶昆臣"}],"time":{"kind":"interval","start":"1807","end":"1859","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"汉阳"},"coord":[114.22,30.55]}]},"summary":{"zh-Hans":"湖北汉阳人，字昆臣。道光年间进士，1850 年升两广总督兼通商大臣，坚拒英人入广州城。1856 年亚罗号事件后对英强硬，1857 年英法联军攻陷广州时被俘，押往印度加尔各答，1859 年绝食死于该地。"},"sources":[{"ref":"source.wiki.叶名琛"}],"tags":["外交","两广总督"],"relations":[{"type":"participant","target":"event.1854.广州"},{"type":"participant","target":"event.1856.广州"},{"type":"participant","target":"event.1857.广州"}]},{"id":"person.balfour","type":"person","labels":{"zh-Hans":"巴富尔","en":"George Balfour"},"time":{"kind":"interval","start":"1809","end":"1894","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23]}]},"summary":{"zh-Hans":"英国军官、外交官，首任驻上海领事。1843 年 11 月到上海，与上海道台宫慕久议定开埠与租地，11 月 17 日宣布上海开埠；1845 年 11 月签订第一次《上海土地章程》，划出洋泾浜至李家场的英租界，是近代中国第一个租界。"},"sources":[{"ref":"source.wiki.巴富尔"}],"tags":["外交","上海"],"relations":[{"type":"participant","target":"event.1843.上海"},{"type":"participant","target":"event.1845.上海"}]},{"id":"person.amaral","type":"person","labels":{"zh-Hans":"亚马留","en":"João Maria Ferreira do Amaral"},"aliases":[{"zh-Hans":"若昂·马里亚·费雷拉·多·亚马留"}],"time":{"kind":"interval","start":"1803","end":"1849","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"澳门"},"coord":[113.55,22.19]}]},"summary":{"zh-Hans":"葡萄牙海军军官，1846 年出任澳门总督。上任后拒交地租、驱逐清朝驻澳官员、强占关闸以南并向华人征税，澳门主权争议由此而起。1849 年 8 月 22 日在关闸附近被龙田村民沈志亮等刺杀。"},"sources":[{"ref":"source.wiki.亚马留"}],"tags":["澳门","外交"],"relations":[{"type":"participant","target":"event.1849.澳门"},{"type":"participant","target":"event.1849.澳门-2"}]},{"id":"person.alcock","type":"person","labels":{"zh-Hans":"阿礼国","en":"Rutherford Alcock"},"aliases":[{"zh-Hans":"阿利国"}],"time":{"kind":"interval","start":"1809","end":"1897","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23]}]},"summary":{"zh-Hans":"英国外交官。1844 年来华，先后任驻厦门、福州、上海、广州领事，1865 年任驻华公使。1848 年青浦教案发生后，他借机以炮舰相逼，迫使上海道台麟桂惩办水手并把英租界由八百三十亩扩至二千八百余亩；1854 年又参与策划上海公共租界工部局。1897 年卒。"},"sources":[{"ref":"source.wiki.阿礼国"}],"tags":["外交","上海","英国"],"relations":[{"type":"participant","target":"event.1848.青浦"}]},{"id":"person.bridgman","type":"person","labels":{"zh-Hans":"裨治文","en":"Elijah Coleman Bridgman"},"time":{"kind":"interval","start":"1801-04-22","end":"1861-11-02","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"广州"},"coord":[113.26,23.13]}]},"nationality":"us","summary":{"zh-Hans":"美国公理会传教士，1830 年到广州，是第一位来华的美国新教传教士。他创办并主编《中国丛报》（1832–1851），向西方系统介绍中国；1844 年随顾盛使团参与《望厦条约》的翻译与谈判。"},"sources":[{"ref":"source.wiki.裨治文"}],"tags":["外国人","美国","宗教"],"relations":[{"type":"member_of","target":"group.chuanjiaoshi"},{"type":"founded","target":"institution.biwen-nvshu"}]},{"id":"person.feng-guifen","type":"person","labels":{"zh-Hans":"冯桂芬","en":"Feng Guifen"},"time":{"kind":"interval","start":"1809","end":"1874","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"苏州"},"coord":[120.619,31.3]}]},"summary":{"zh-Hans":"苏州人。著《校邠庐抗议》，提出「中体西用」的雏形。"},"sources":[{"ref":"source.wiki.馮桂芬"}],"tags":["思想","政治"],"visits":[{"kind":"residence","name":{"zh-Hans":"冯桂芬祠"},"address":{"zh-Hans":"江苏省苏州市临顿路史家巷 20 号"},"note":{"zh-Hans":"市级文物保护单位（苏州市保）。冯桂芬（1809—1874）是晚清思想家，著《校邠庐抗议》，提出「以中国之伦常名教为原本，辅以诸国富强之术」，是洋务思想先声；祠在临顿路史家巷。"},"status":"extant","sources":[{"ref":"source.市县级名录"}]},{"kind":"grave","name":{"zh-Hans":"冯桂芬墓"},"address":{"zh-Hans":"江苏省苏州市藏书镇"},"note":{"zh-Hans":"市级文物保护单位（苏州市保）。冯桂芬归葬藏书镇；与城里的祠一城一乡，可并作半天。"},"status":"extant","sources":[{"ref":"source.市县级名录"}]}],"relations":[{"type":"member_of","target":"group.xuezhe"}]},{"id":"person.guo-baiyin","type":"person","labels":{"zh-Hans":"郭柏荫"},"aliases":[{"zh-Hans":"郭远堂"}],"time":{"kind":"interval","start":"1807","end":"1884","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"福州"},"coord":[119.3,26.08]}]},"summary":{"zh-Hans":"福建侯官人，字远堂。道光十二年进士，官至江苏、广西、湖北巡抚，署湖广总督；同治十二年因病辞官，光绪元年回福州，主讲鳌峰书院，曾主持浚河排涝、倡修文庙。故居在黄巷，郭家五兄弟皆登科，宅前悬「五子登科」匾。 "},"visits":[{"kind":"residence","name":{"zh-Hans":"郭柏荫故居（五子登科宅）"},"address":{"zh-Hans":"福建省福州市鼓楼区 黄巷 东段北侧（旧 6—7 号，今门牌说法不一）"},"note":{"zh-Hans":"属全国重点文物保护单位「三坊七巷和朱紫坊建筑群」（第六批）的组成部分。福建省文物保护单位（2005 年）。宅始建于明末，原系衙门，清同治年间郭柏荫显贵后购置重修，面积两千余平方米、主座三进；郭阶三五子皆中科第，故俗称「五子登科」宅。他弟弟郭柏苍（《闽产录异》的作者）也住这处大宅。同巷 36 号的「小黄楼」是梁章钜修的，两处别混。"},"status":"extant","since":"1863","sources":[{"ref":"source.web.福州古厝·郭柏荫故居"},{"ref":"source.国保名录"}]}],"sources":[{"ref":"source.web.福州古厝·郭柏荫故居"}],"tags":["督抚","福州"]},{"id":"person.hechun","type":"person","labels":{"zh-Hans":"和春"},"time":{"kind":"interval","start":"1800","end":"1860","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"满洲正黄旗人，清军将领；继向荣主持江南大营，1860 年大营被破后自杀。"},"sources":[{"ref":"source.《太平天国史》"}],"tags":["人物","太平天国","清军"],"relations":[{"type":"participant","target":"event.1860.江南大营"}]},{"id":"person.tuominga","type":"person","labels":{"zh-Hans":"托明阿"},"time":{"kind":"interval","start":"1800","end":"1865","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"满洲正黄旗人，清军将领；接替琦善主持江北大营。"},"sources":[{"ref":"source.《太平天国史》"}],"tags":["人物","太平天国","清军"],"relations":[{"type":"participant","target":"event.1853.北伐"}]},{"id":"person.elliot2","type":"person","labels":{"zh-Hans":"义律"},"time":{"kind":"interval","start":"1801","end":"1875","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"广州"},"coord":[113.38,23.13]}]},