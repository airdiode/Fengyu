me":{"kind":"interval","start":"1820","end":"1898","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"汉城"},"coord":[126.98,37.57]}]},"summary":{"zh-Hans":"朝鲜兴宣大院君；甲午年重新掌权，推动甲午改革。"},"sources":[{"ref":"source.《甲午战争史》"}],"tags":["人物","甲午","朝鲜"],"relations":[{"type":"participant","target":"event.1894.汉城"}]},{"id":"person.liu-lichuan","type":"person","labels":{"zh-Hans":"刘丽川","en":"Liu Lichuan"},"time":{"kind":"interval","start":"1820","end":"1855","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"香山"},"coord":[113.39,22.52]}]},"summary":{"zh-Hans":"广东香山人，农民出身。1845 年在香港加入天地会，1849 年到上海；1853 年 9 月与陈阿林、周立春等领导小刀会起义，占领上海县城，称「大明国统理政教招讨大元帅」，并上书洪秀全表示归附。1855 年 2 月突围时战死。"},"sources":[{"ref":"source.wiki.刘丽川"}],"tags":["会党","起义"],"relations":[{"type":"member_of","target":"org.tiandihui"},{"type":"custom:leader_of","target":"org.xiaodaohui"},{"type":"custom:leader_of","target":"org.sh-xiaodaohui"},{"type":"commanded","target":"event.1853.上海"}]},{"id":"person.chen-kai","type":"person","labels":{"zh-Hans":"陈开","en":"Chen Kai"},"time":{"kind":"interval","start":"1822","end":"1861","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"佛山"},"coord":[113.12,23.02]}]},"summary":{"zh-Hans":"广东鹤山（一说三水）人，早年在佛山做工，为天地会洪顺堂首领。1854 年 7 月在佛山起义，与李文茂合攻广州不克，转攻广西；1855 年 9 月占浔州，建立大成国，称镇南王（后改平浔王），改浔州为秀京。1861 年秀京失守后被俘遇害。"},"sources":[{"ref":"source.wiki.陈开"}],"tags":["会党","起义"],"relations":[{"type":"custom:leader_of","target":"org.sanhehui"},{"type":"custom:leader_of","target":"org.dacheng"},{"type":"commanded","target":"event.1854.广州"}]},{"id":"person.du-wenxiu","type":"person","labels":{"zh-Hans":"杜文秀","en":"Du Wenxiu"},"time":{"kind":"interval","start":"1823","end":"1872","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"保山"},"coord":[99.17,25.11]}]},"summary":{"zh-Hans":"云南永昌保山人，回族，曾中秀才。1856 年因汉回冲突在蒙化举事，攻克大理，被推为「总统兵马大元帅」，建大理政权，据滇西十八年。1872 年大理城破，服毒后被解往清营遇害。"},"sources":[{"ref":"source.wiki.杜文秀"}],"tags":["回族","起义"],"visits":[{"kind":"grave","name":{"zh-Hans":"杜文秀墓"},"address":{"zh-Hans":"云南省大理州大理市大理旧城东南下兑村（约 5 公里）"},"note":{"zh-Hans":"第二批云南省保（1983 年公布）。1872 年大理城被清军攻破，杜文秀服毒后被处死，遗体归葬下兑村；墓园在下兑村内，离大理古城约 5 公里，可与帅府旧址同日看。"},"status":"extant","sources":[{"ref":"source.省保名录"},{"ref":"source.web.杜文秀墓"}],"since":"1872"},{"kind":"site","name":{"zh-Hans":"杜文秀帅府旧址（大理市博物馆）"},"address":{"zh-Hans":"云南省大理州大理市大理古城复兴路 111 号"},"note":{"zh-Hans":"1993 年公布为云南省保。原为清云南提督衙门；1856 年杜文秀等攻占大理府城后，在提督府内设元帅府，他被推为「总统兵马大元帅」，以大理为中心建立反清政权。今为大理市博物馆，馆内设杜文秀起义图片与实物展。"},"status":"extant","sources":[{"ref":"source.省保名录"},{"ref":"source.web.杜文秀帅府"}],"since":"1856"}],"relations":[{"type":"custom:leader_of","target":"org.yn-hui"}]},{"id":"person.zhang-xiumei","type":"person","labels":{"zh-Hans":"张秀眉","en":"Zhang Xiumei"},"time":{"kind":"interval","start":"1823","end":"1872","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"台拱"},"coord":[108.07,26.67]}]},"summary":{"zh-Hans":"贵州台拱厅人，苗族。1855 年 4 月在台拱领导苗民起事，据黔东南，与清军相持十八年，曾配合太平军余部。1872 年在乌鸦坡战败被俘，押往长沙遇害。"},"sources":[{"ref":"source.wiki.张秀眉"}],"tags":["苗族","起义"],"relations":[{"type":"custom:leader_of","target":"org.gz-miao"}]},{"id":"person.wang-jueyi","type":"person","labels":{"zh-Hans":"王觉一","en":"Wang Jueyi"},"aliases":[{"zh-Hans":"王希孟"},{"zh-Hans":"北海老人"}],"time":{"kind":"interval","start":"1821","end":"1886","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"青州"},"coord":[118.48,36.69]}]},"summary":{"zh-Hans":"山东青州人，原名希孟，号北海老人。先天道姚鹤天门下，1877 年在青州创立东震堂（末后一着教），为一贯道前身，被奉为第十五代祖师；著《理数合解》《历年易理》。1883 年教派遭清廷查禁，1886 年卒。"},"sources":[{"ref":"source.wiki.王觉一"}],"tags":["宗教","一贯道"],"relations":[{"type":"founded","target":"org.yiguandao"}]},{"id":"person.yang-xiuqing","type":"person","labels":{"zh-Hans":"杨秀清","en":"Yang Xiuqing"},"time":{"kind":"interval","start":"1821","end":"1856","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"桂平"},"coord":[110.083,23.4]}]},"summary":{"zh-Hans":"桂平人。太平天国东王，实际主持军政，「天京事变」中被杀。"},"sources":[{"ref":"source.wiki.杨秀清"}],"tags":["政治","军事"],"relations":[{"type":"member_of","target":"group.taiping"},{"type":"participant","target":"event.1856.天京"},{"type":"participant","target":"event.1851.金田"},{"type":"participant","target":"event.1852.永安"},{"type":"participant","target":"event.1853.天京南京"}]},{"id":"person.hong-rengan","type":"person","labels":{"zh-Hans":"洪仁玕","en":"Hong Rengan"},"time":{"kind":"interval","start":"1822","end":"1864","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"花都区"},"coord":[113.211,23.394]}]},"summary":{"zh-Hans":"花都区人。太平天国干王，提出《资政新篇》，最早的近代化方案之一。"},"sources":[{"ref":"source.wiki.洪仁玕"}],"tags":["政治"],"visits":[{"kind":"site","name":{"zh-Hans":"牛眠埔洪仁玕避难遗迹"},"address":{"zh-Hans":"广东省东莞市"},"note":{"zh-Hans":"省级文物保护单位（第五批）。洪仁玕早年避居东莞牛眠埔的遗迹；他 1859 年到天京后总理朝政，著《资政新篇》。"},"status":"extant","sources":[{"ref":"source.省保名录"}]}],"relations":[{"type":"member_of","target":"group.taiping"},{"type":"participant","target":"event.1859.资政新篇"}]},{"id":"person.li-xiucheng","type":"person","labels":{"zh-Hans":"李秀成","en":"Li Xiucheng"},"time":{"kind":"interval","start":"1823","end":"1864","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"藤县"},"coord":[110.924,23.377]}]},"summary":{"zh-Hans":"藤县人。太平天国忠王，苏浙战场主帅，天京失守后被俘。"},"sources":[{"ref":"source.wiki.李秀成"}],"tags":["军事","政治"],"visits":[{"kind":"site","name":{"zh-Hans":"太平天国忠王府"},"address":{"zh-Hans":"江苏省苏州市姑苏区 东北街 202 号（拙政园西侧）"},"note":{"zh-Hans":"第一批国保（1860—1863 年）。1860 年太平军克苏州后，李秀成以拙政园旧址扩建忠王府，是现存最完整的一组太平天国建筑；1863 年苏州失守，李鸿章据为江苏巡抚行辕，后长期作官署。今为苏州博物馆一部分，与拙政园相邻，可一并看。"},"status":"extant","since":"1860","sources":[{"ref":"source.国保名录"},{"ref":"source.web.苏州文物"}]}],"relations":[{"type":"member_of","target":"group.taiping"},{"type":"participant","target":"event.1858.浦口"},{"type":"participant","target":"event.1858.三河"},{"type":"participant","target":"event.1860.江南大营"},{"type":"participant","target":"event.1864.天京陷落南京"},{"type":"participant","target":"event.1863.苏州"}]},{"id":"person.lai-wenguang","type":"person","labels":{"zh-Hans":"赖文光","en":"Lai Wenguang"},"time":{"kind":"interval","start":"1827","end":"1868","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"梅州"},"coord":[116.119,24.3]}]},"summary":{"zh-Hans":"梅州人。捻军后期统帅，改步为骑，1868年扬州被俘。"},"sources":[{"ref":"source.wiki.赖文光"}],"tags":["军事","政治"],"relations":[{"type":"member_of","target":"org.nianjun"}]},{"id":"person.zeng-guoquan","type":"person","labels":{"zh-Hans":"曾国荃","en":"Zeng Guoquan"},"time":{"kind":"interval","start":"1824","end":"1890","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"湘乡"},"coord":[112.522,27.739]}]},"summary":{"zh-Hans":"湘乡人。湘军主将，1864年攻陷天京。活跃于 1856—1890 年。"},"sources":[{"ref":"source.wiki.曾国荃"}],"tags":["军事","政治"],"visits":[{"kind":"memorial","name":{"zh-Hans":"曾国荃祠堂"},"address":{"zh-Hans":"天津市河北区光复道 47 号"},"note":{"zh-Hans":"区级文物保护单位（河北区）。曾国荃是曾国藩九弟、湘军将领，官至两江总督；祠堂建于 1910 年代，在原天津意租界，今为福楼餐厅。"},"status":"extant","sources":[{"ref":"source.web.曾国荃祠堂"}]}],"relations":[{"type":"custom:sibling_of","target":"person.zengguofan","note":{"zh-Hans":"曾国藩九弟，湘军吉字营统领"},"source":["source.wiki.曾国荃"]},{"type":"member_of","target":"group.xiangjun"},{"type":"participant","target":"event.1861.安庆府"},{"type":"participant","target":"event.1864.天京陷落南京"},{"type":"participant","target":"event.1876.丁戊奇荒"}]},{"id":"person.ding-baozhen","type":"person","labels":{"zh-Hans":"丁宝桢","en":"Ding Baozhen"},"time":{"kind":"interval","start":"1820","end":"1886","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"织金县"},"coord":[105.769,26.672]}]},"summary":{"zh-Hans":"织金县人。山东、四川总督，创办机器局，整顿盐政。"},"sources":[{"ref":"source.wiki.丁宝桢"}],"tags":["政治"],"relations":[{"type":"member_of","target":"group.qing-dufu"}]},{"id":"person.x","type":"person","labels":{"zh-Hans":"王韬"},"time":{"kind":"interval","start":"1828","end":"1897","precision":"year"},"summary":{"zh-Hans":"甪直人。创办《循环日报》，倡言变法自强，近代华人第一位政论家与新闻记者。"},"sources":[{"ref":"source.wiki.王韬 (1828年)"}],"tags":["思想","政治"],"space":{"points":[{"name":{"zh-Hans":"甪直"},"coord":[120.863,31.274]}]},"relations":[{"type":"member_of","target":"group.yangwu"}]},{"id":"person.pao-chen-shen","type":"person","labels":{"zh-Hans":"沈葆桢","en":"Pao-chen Shen"},"time":{"kind":"interval","start":"1820","end":"1879","precision":"year"},"summary":{"zh-Hans":"福州人。首任船政大臣，主持福州船政与台湾防务。活跃于 1866—1879 年。"},"sources":[{"ref":"source.wiki.沈葆楨"}],"tags":["政治"],"space":{"points":[{"name":{"zh-Hans":"福州"},"coord":[119.292,26.077]}]},"visits":[{"kind":"residence","name":{"zh-Hans":"沈葆桢故居（宫巷）"},"address":{"zh-Hans":"福建省福州市鼓楼区 宫巷 26 号"},"note":{"zh-Hans":"第六批国保（2006 年，随三坊七巷建筑群）。宅始建于明代天启年间，清同治年间沈葆桢购置修葺，占地 2747 平方米，是清代福州典型官宦人家大院；他在此筹划船政与台湾防务；今作沈葆桢史迹展，开放时间以现场为准。国保名录作「三坊七巷和朱紫坊建筑群」（第六批）。"},"status":"extant","since":"1866","sources":[{"ref":"source.国保名录"},{"ref":"source.web.沈葆桢故居"}]}],"relations":[{"type":"member_of","target":"group.yangwu"},{"type":"custom:director_of","target":"institution.fuzhou-chuanzheng"},{"type":"member_of","target":"group.qing-dufu"},{"type":"participant","target":"event.1874.北京"},{"type":"participant","target":"event.1875.船政留欧"},{"type":"custom:director_of","target":"institution.fuzhou-chuanzhengju"}]},{"id":"person.lin-congyi","type":"person","labels":{"zh-Hans":"林聪彝"},"time":{"kind":"interval","start":"1824","end":"1878","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"福州"},"coord":[119.3,26.08]}]},"summary":{"zh-Hans":"林则徐次子，字听孙。道光年间随父遣戍伊犁，一路照料起居；林则徐卒后归闽，历官浙江按察使、杭嘉湖道等职。故居在宫巷 24 号，明代建筑，清道光间购入，是三坊七巷现存最大的宅院之一。 "},"visits":[{"kind":"residence","name":{"zh-Hans":"林聪彝故居"},"address":{"zh-Hans":"福建省福州市鼓楼区 宫巷 24 号"},"note":{"zh-Hans":"全国重点文物保护单位（2006 年，随三坊七巷建筑群列入）。宅始建于明代，占地近 3000 平方米；1645 年唐王朱聿键在福州称帝（隆武）时曾在此设大理寺衙门，道光年间由林聪彝购置。今作「城市会客厅」使用，开放情况以现场为准。国保名录作「三坊七巷和朱紫坊建筑群」（第六批）。"},"status":"extant","since":"1645","sources":[{"ref":"source.web.三坊七巷"}]}],"sources":[{"ref":"source.web.三坊七巷"}],"tags":["林则徐家族","福州"]},{"id":"person.zhang-yuzhao","type":"person","labels":{"zh-Hans":"张裕钊","en":"Zhang Yuzhao"},"time":{"kind":"interval","start":"1823","end":"1894","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"武昌"},"coord":[114.89,30.4]}]},"summary":{"zh-Hans":"湖北武昌人。学者、书法家，「曾门四弟子」之一。"},"sources":[{"ref":"source.省保名录"}],"tags":["学术"],"visits":[{"kind":"grave","name":{"zh-Hans":"张裕钊墓"},"address":{"zh-Hans":"湖北省鄂州市鄂城区"},"note":{"zh-Hans":"省级文物保护单位（第五批）。张裕钊墓在鄂城区。"},"status":"extant","sources":[{"ref":"source.省保名录"}]}]},{"id":"person.yu-yue","type":"person","labels":{"zh-Hans":"俞樾","en":"Yu Yue"},"time":{"kind":"interval","start":"1821","end":"1907","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"苏州"},"coord":[120.62,31.3]}]},"summary":{"zh-Hans":"浙江德清人，长期居苏州。清末经学家、文学家，章太炎、吴昌硕之师，居所「曲园」。"},"sources":[{"ref":"source.国保名录"}],"tags":["学术"],"visits":[{"kind":"residence","name":{"zh-Hans":"俞樾旧居（曲园）"},"address":{"zh-Hans":"江苏省苏州市"},"note":{"zh-Hans":"全国重点文物保护单位（第六批）。俞樾旧居即苏州曲园，是他晚年著书讲学处。"},"status":"extant","sources":[{"ref":"source.国保名录"}]}]},{"id":"person.dingrichang","type":"person","labels":{"zh-Hans":"丁日昌"},"time":{"kind":"interval","start":"1823","end":"1882","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"丰顺"},"coord":[116.18,23.74]}]},"roles":["巡抚"],"summary":{"zh-Hans":"洋务派官员，江苏、福建巡抚；参与江南制造局与轮船招商局。"},"sources":[{"ref":"source.《清史稿》"}],"tags":["人物","清朝","洋务"],"visits":[{"kind":"residence","name":{"zh-Hans":"丁日昌旧居"},"address":{"zh-Hans":"广东省揭阳市榕城区"},"note":{"zh-Hans":"省级文物保护单位（第五批）。丁日昌（1823—1882）是洋务派官员，历任江苏、福建巡抚，参与创办江南制造局、福州船政；旧居在揭阳榕城区。"},"status":"extant","sources":[{"ref":"source.省保名录"}]}],"relations":[{"type":"member_of","target":"group.yangwu"},{"type":"member_of","target":"group.qing-dufu"}]},{"id":"person.huxueyan","type":"person","labels":{"zh-Hans":"胡雪岩"},"time":{"kind":"interval","start":"1823","end":"1885","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"绩溪"},"coord":[118.6,30.07]}]},"roles":["钱庄商","实业家"],"summary":{"zh-Hans":"阜康钱庄、胡庆余堂；为左宗棠西征筹饷，后破产。"},"sources":[{"ref":"source.wiki.胡雪岩"}],"tags":["人物","商贾","金融"],"visits":[{"kind":"residence","name":{"zh-Hans":"胡雪岩旧居"},"address":{"zh-Hans":"浙江省杭州市上城区元宝街 18 号"},"note":{"zh-Hans":"全国重点文物保护单位（第六批）。胡雪岩 1872 年斥巨资建的