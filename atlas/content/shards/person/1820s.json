{"key":"person/1820s","entities":[{"id":"person.lihongzhang","type":"person","labels":{"zh-Hans":"李鸿章","en":"Li Hongzhang"},"aliases":[{"zh-Hans":"李中堂"},{"zh-Hans":"少荃"},{"zh-Hans":"李文忠"}],"time":{"kind":"interval","start":"1823","end":"1901","precision":"year"},"nationality":"china","roles":[],"sources":[{"ref":"source.legacy.person"}],"summary":{"zh-Hans":"安徽合肥人，淮军与北洋水师创办者，1870 年代起任直隶总督兼北洋大臣，主持洋务；1895 年签订《马关条约》，1901 年签订《辛丑条约》。"},"visits":[{"kind":"grave","name":{"zh-Hans":"李鸿章享堂（墓园遗址）"},"address":{"zh-Hans":"安徽省合肥市瑶海区大兴镇裕溪路 415 号"},"note":{"zh-Hans":"省级文物保护单位（第五批，名录作「李鸿章享堂」）。1903 年灵柩自北京运回合肥，葬于东乡夏小郢（大兴集），离包公墓约 300 米。墓本体 1958 年被挖毁，如今能看到的是幸存的享堂（前后三进 99 间）与墓园遗址——去之前要知道这一点，别以为能看到原墓。"},"status":"lost","sources":[{"ref":"source.web.李鸿章享堂"},{"ref":"source.省保名录"}]},{"kind":"residence","name":{"zh-Hans":"李鸿章故居（李府）"},"address":{"zh-Hans":"安徽省合肥市庐阳区淮河路步行街中段 208 号"},"note":{"zh-Hans":"省级文物保护单位（第四批，名录作「李鸿章故居及享堂」）。合肥最热闹的步行街上，晚清江淮民居，门楣上「李府」二字。门票与预约各来源说法不一，以官方公告为准。"},"status":"extant","sources":[{"ref":"source.web.李鸿章故居"},{"ref":"source.省保名录"}]}],"space":{"points":[{"name":{"zh-Hans":"合肥"},"coord":[117.28,31.86]},{"name":{"zh-Hans":"天津"},"coord":[117.2,39.13],"role":"activity","time":{"kind":"interval","start":"1870","end":"1901","precision":"year"}}]},"relations":[{"type":"subordinate_of","target":"person.zengguofan","note":{"zh-Hans":"曾国藩幕僚、门生，湘军出身"},"source":["source.legacy.person"]},{"type":"custom:colleague_of","target":"person.guo-songtao","note":{"zh-Hans":"同办洋务；郭嵩焘首任驻英公使"},"source":["source.wiki.郭嵩焘"]},{"type":"custom:colleague_of","target":"person.liu-kunyi","note":{"zh-Hans":"同任督抚，东南互保共主"},"source":["source.wiki.劉坤一"]},{"type":"member_of","target":"group.huaijun"},{"type":"member_of","target":"group.yangwu"},{"type":"member_of","target":"group.qing-dufu"},{"type":"participant","target":"event.1865.上海"},{"type":"participant","target":"event.1870.天津"},{"type":"participant","target":"event.1872.上海"},{"type":"participant","target":"event.1876.烟台芝罘今山东烟台"},{"type":"participant