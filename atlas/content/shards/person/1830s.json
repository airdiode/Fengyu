北京"},{"type":"participant","target":"event.1887.北京"},{"type":"participant","target":"event.treaty.jiewu-1887"}]},{"id":"person.bai-yanhu","type":"person","labels":{"zh-Hans":"白彦虎","en":"Bai Yanhu"},"aliases":[{"zh-Hans":"白素"},{"zh-Hans":"穆罕默德·阿尤布"}],"time":{"kind":"interval","start":"1830","end":"1882","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"乌鲁木齐"},"coord":[87.6,43.8]}]},"summary":{"zh-Hans":"陕西人，同治陕甘回变的主要首领之一、回民军十八大营元帅之一。屡败于左宗棠、刘锦棠部而屡次脱走，后率部进入新疆与阿古柏合流，是清军西征时叛军一方的主要将领；1877 年随伯克·胡里败退入俄境。"},"relations":[{"type":"allied_with","target":"person.yaqub-beg"},{"type":"member_of","target":"group.xinjiang-rebels"},{"type":"participant","target":"event.1876.乌鲁木齐"},{"type":"participant","target":"event.1878.喀什噶尔今新疆喀什"},{"type":"custom:leader_of","target":"org.sg-hui"}],"sources":[{"ref":"source.wiki.白彥虎"}],"tags":["陕甘回变","新疆","回民军"]},{"id":"person.tuoming","type":"person","labels":{"zh-Hans":"妥得璘","en":"Tuo Delin"},"aliases":[{"zh-Hans":"妥明"},{"zh-Hans":"达吾提"}],"time":{"kind":"interval","start":"1830","end":"1872","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"乌鲁木齐"},"coord":[87.6,43.8]}]},"summary":{"zh-Hans":"东干回族，同治新疆回变的起事领袖。1864 年与提督参将索焕章在乌鲁木齐反清自立，称「清真王」，据乌鲁木齐、玛纳斯、吐鲁番；1870 年曾与汉族团练徐学功议和、把阿古柏逐出乌鲁木齐，同年秋兵败求和；1872 年阿古柏再犯，退守玛纳斯，城破自尽。"},"sources":[{"ref":"source.wiki.妥得璘"}],"tags":["新疆","回民军","乌鲁木齐"],"relations":[{"type":"member_of","target":"group.xinjiang-rebels"}]},{"id":"person.mateer","type":"person","labels":{"zh-Hans":"狄考文"},"aliases":[{"zh-Hans":"Calvin Wilson Mateer"},{"zh-Hans":"狄考文牧师"}],"time":{"kind":"interval","start":"1836-01-09","end":"1908-09-28","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"坎伯兰县"},"coord":[-77,40.05]},{"name":{"zh-Hans":"蓬莱"},"coord":[120.76,37.81],"role":"activity"}]},"nationality":"us","summary":{"zh-Hans":"美国美北长老会传教士、教育家，1836—1908。1863 年到山东登州，1864 年创办蒙养学堂（后为登州文会馆、Tengchow College），1882 年把它提高到大学程度；与夫人狄邦就烈等编《官话类编》《华语大词典》，是当时外国人学汉语的主要教材，也是山东近代教育的开创者之一。"},"sources":[{"ref":"source.wiki.狄考文"},{"ref":"source.wiki.登州文会馆"}],"tags":["教育","美国","外国人","传教士","晚清"],"relations":[{"type":"participant","target":"event.1864.登州文会馆"}]},{"id":"person.wudacheng","type":"person","labels":{"zh-Hans":"吴大澂"},"aliases":[{"zh-Hans":"吴清卿"},{"zh-Hans":"愙斋"},{"zh-Hans":"止敬"},{"zh-Hans":"淸卿"},{"zh-Hans":"清卿"},{"zh-Hans":"吴大淳"},{"zh-Hans":"二十八将军印斋"},{"zh-Hans":"二田居士"}],"time":{"kind":"interval","start":"1835-06-06","end":"1902-03-06","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"吴县（今苏州）"},"coord":[120.62,31.3]}]},"summary":{"zh-Hans":"字清卿、止敬，号恒轩、愙斋，江苏吴县人，同治七年（1868）进士。1880 年以三品卿衔赴吉林帮办边务，次年督办，编练巩、卫、绥、安四军，1881 年奏设吉林机器局。1886 年奉使珲春与俄使勘界，重立「土」字碑，争回图们江口的航行权。历官陕甘学政、广东巡抚、湖南巡抚、河东河道总督。甲午战起自请督师出关，任东征军务帮办，率湘军三千赴辽，1895 年 3 月在牛庄一带兵败被革职。工篆书，精金石学与古文字学，著《愙斋集古录》《说文古籀补》《古玉图考》，是吴湖帆的祖父。"},"sources":[{"ref":"source.web.吴大澂生平"},{"ref":"source.web.吉林机器局"}],"tags":["官员","金石学","洋务","晚清"],"relations":[{"type":"custom:student_of","target":"person.yu-yue","note":{"zh-Hans":"CBDB 记「為Y之學生」"},"source":["source.cbdb"]},{"type":"custom:student_of","target":"person.feng-guifen","note":{"zh-Hans":"CBDB 记「為Y之弟子」"},"source":["source.cbdb"]}]},{"id":"person.schereschewsky","type":"person","labels":{"zh-Hans":"施约瑟"},"aliases":[{"zh-Hans":"Samuel Isaac Joseph Schereschewsky"},{"zh-Hans":"施若瑟"}],"time":{"kind":"interval","start":"1831-05-21","end":"1906-10-15","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23],"role":"activity"}]},"nationality":"us","summary":{"zh-Hans":"美国圣公会派驻中国的主教、圣经翻译者，1831—1906。1879 年在上海创办圣约翰书院并任首任校长；译有北京官话旧约圣经与文理本新旧约圣经，是近代中文圣经翻译的关键人物之一。"},"sources":[{"ref":"source.wiki.施约瑟"},{"ref":"source.wiki.圣约翰大学"}],"tags":["教育","美国","外国人","传教士","晚清"],"relations":[{"type":"participant","target":"event.1879.圣约翰"}]},{"id":"person.allen","type":"person","labels":{"zh-Hans":"林乐知"},"aliases":[{"zh-Hans":"Young John Allen"},{"zh-Hans":"杨格·约翰·艾伦"}],"time":{"kind":"interval","start":"1836-01-23","end":"1907-05-31","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"伯克县"},"coord":[-83.2,33]},{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23],"role":"activity"}]},"nationality":"us","summary":{"zh-Hans":"美国监理会来华传教士，在华 47 年，以办报、办学、译书著称。1868 年在上海创办《教会新报》，1874 年将其改名《万国公报》，1889 年复刊后作为广学会机关报继续主编至去世；1899 年该刊连载《大同学》，最早把马克思、恩格斯的名字介绍给中文读者。1876 年清政府赏五品顶戴。1907 年 5 月 31 日病逝于上海。"},"sources":[{"ref":"source.wiki.林乐知"},{"ref":"source.wiki.万国公报"}],"tags":["报刊","美国","外国人","传教士"],"relations":[{"type":"participant","target":"event.1874.万国公报"}]}]}