ace":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清宗室，靖逆将军；广州之战失利，后与俄国签订《瑷珲条约》。"},"sources":[{"ref":"source.《天朝的崩溃》"}],"tags":["人物","鸦片战争","宗室"],"relations":[{"type":"participant","target":"event.treaty.aigun-1858"},{"type":"participant","target":"event.1851.伊犁"}]},{"id":"person.yijing","type":"person","labels":{"zh-Hans":"奕经"},"time":{"kind":"interval","start":"1791","end":"1853","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清宗室，扬威将军；浙江战场反攻失败，镇海、宁波相继失守。"},"sources":[{"ref":"source.《天朝的崩溃》"}],"tags":["人物","鸦片战争","宗室"],"relations":[{"type":"participant","target":"event.1841.镇海之战"},{"type":"participant","target":"event.1842.宁波之战"}]},{"id":"person.medhurst","type":"person","labels":{"zh-Hans":"麦都思"},"aliases":[{"zh-Hans":"Walter Henry Medhurst"},{"zh-Hans":"米怜"}],"time":{"kind":"interval","start":"1796-04-29","end":"1857-01-24","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"伦敦"},"coord":[-0.13,51.51]}]},"nationality":"uk","summary":{"zh-Hans":"英国伦敦会传教士、汉学家，生于伦敦。早年在马六甲、槟城传教并研究中文，1843 年开埠后到上海，是墨海书馆的创办者之一，与王韬等合译西书。1853 年在香港创办《遐迩贯珍》并任首任总编辑，是早期中文报刊的开创者之一；1857 年卒。"},"sources":[{"ref":"source.wiki.麦都思"},{"ref":"source.wiki.遐迩贯珍"}],"tags":["报刊","英国","外国人","传教士","晚清"],"relations":[{"type":"participant","target":"event.1853.遐迩贯珍"}]},{"id":"person.wu-jianzhang","type":"person","labels":{"zh-Hans":"吴健彰"},"aliases":[{"zh-Hans":"吴天显"},{"zh-Hans":"吴爽官"}],"time":{"kind":"interval","start":"1791","end":"1866-07","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"香山"},"coord":[113.53,22.36]}]},"nationality":"china","summary":{"zh-Hans":"广东香山人，早年在广州、上海经商，捐纳得官，1850 年代任苏松太道（上海道台）。小刀会起事时江海关关署被毁、关税停征，他与英法美三国领事订立协定，允许三国各派税务司一人协助管理江海关，开了外籍税务司管理中国海关的先例；1854 年他还借英美舰船镇压小刀会。1866 年 7 月卒于香山。"},"sources":[{"ref":"source.wiki.吴健彰"},{"ref":"source.wiki.江海关"}],"tags":["海关","晚清","上海"],"relations":[{"type":"participant","target":"event.1854.江海关"}]},{"id":"person.leiyixian","type":"person","labels":{"zh-Hans":"雷以諴"},"aliases":[{"zh-Hans":"雷鸣"},{"zh-Hans":"雷鹤皋"},{"zh-Hans":"春霆"},{"zh-Hans":"省之"},{"zh-Hans":"藿郊"},{"zh-Hans":"鹤皋"}],"time":{"kind":"interval","start":"1794","end":"1884","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"扬州"},"coord":[119.42,32.39],"role":"activity"}]},"nationality":"china","summary":{"zh-Hans":"原名鸣，字省之、作霖，号鹤皋，1794—1884。咸丰年间任江北大营军务大臣，1853 年在扬州一带开征厘金，以「值百抽一」筹军饷，被各省仿行，成为晚清最重要的商税之一。"},"sources":[{"ref":"source.wiki.雷以諴"},{"ref":"source.wiki.釐金"},{"ref":"source.book.湖北诗征传略"}],"tags":["经济","财政","晚清"],"relations":[{"type":"participant","target":"event.1853.厘金"}],"career":{"postings":["1838 年任刑部河南司主事","1850 年任府丞","1860 年任按察使"]}}]}