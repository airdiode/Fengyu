{"key":"person/1850s","entities":[{"id":"person.kangyouwei","type":"person","labels":{"zh-Hans":"康有为","en":"Kang Youwei"},"aliases":[{"zh-Hans":"康南海"},{"zh-Hans":"长素"},{"zh-Hans":"康长素"}],"time":{"kind":"interval","start":"1858","end":"1927","precision":"year"},"nationality":"china","roles":[],"sources":[{"ref":"source.legacy.person"}],"summary":{"zh-Hans":"广东南海人，1895 年联合应试举人上书，1898 年戊戌变法的核心人物，失败后流亡海外。"},"visits":[{"kind":"residence","name":{"zh-Hans":"康有为故居（天游园）"},"address":{"zh-Hans":"山东省青岛市市南区福山支路 5 号"},"note":{"zh-Hans":"省级文物保护单位（山东省）。德式砖混小楼，1923 年康有为迁居于此、取名「天游园」，在此终老。免费、需预约；周二至周日 9:00–17:00，周一闭馆。"},"status":"extant","sources":[{"ref":"source.web.康有为故居"},{"ref":"source.web.康有为青岛故居"}]},{"kind":"grave","name":{"zh-Hans":"康有为墓（浮山）"},"address":{"zh-Hans":"山东省青岛市市南区浮山南麓大麦岛村北山"},"note":{"zh-Hans":"省级文物保护单位（山东省，1992 年公布）。1927 年病逝青岛，先厝象耳山，1943 年安葬，1966 年被毁，1985 年迁到浮山南麓。墓碑是弟子刘海粟撰书，墓后 6 株龙柏纪念戊戌六君子。与福山支路故居同在青岛，可一天走完。"},"status":"moved","since":"1985","sources":[{"ref":"source.web.康有为墓"}]}],"space":{"points":[{"name":{"zh-Hans":"佛山"},"coord":[113.14,23.03]},{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92],"role":"activity","time":{"kind":"interval","start":"1895","end":"1898","precision":"year"}}]},"relations":[{"type":"custom:teacher_of","target":"person.liangqichao","note":{"zh-Hans":"万木草堂弟子，师生同倡变法"},"source":["source.textbook-8a"]},{"type":"founded","target":"org.qiangxuehui"},{"type":"founded","target":"org.baoguohui"},{"type":"participant","target":"event.1895.北京"}]},{"id":"person.yanfu","type":"person","labels":{"zh-Hans":"严复","en":"Yan Fu"},"aliases":[{"zh-Hans":"几道"},{"zh-Hans":"严几道"}],"time":{"kind":"interval","start":"1854","end":"1921","precision":"year"},"nationality":"china","roles":[],"sources":[{"ref":"source.legacy.person"}],"summary":{"zh-Hans":"福建侯官人，福州船政学堂毕业后赴英留学，1898 年译《天演论》，曾任天津水师学堂总教习。"},"visits":[{"kind":"residence","name":{"zh-Hans":"严复故居（郎官巷）"},"address":{"zh-Hans":"福建省福州市鼓楼区郎官巷 20 号"},"note":{"zh-Hans":"三坊七巷里的国保院落，占地 609 平方米，常设「少年励志／投身海军／教育救国」主题展。8:30–17:00；门票有「免费」与「20 元」两说，以景区公告为准。三坊七巷街区不大，步行半小时能串起好几处故居——严复（郎官巷 20 号）、林觉民·冰心（杨桥东路 17 号）、沈葆桢（宫巷 11 号）都在步行圈内。"},"status":"extant","sources":[{"ref":"source.web.严复故居"}]},{"kind":"grave","name":{"zh-Hans":"严复墓"},"address":{"zh-Hans":"福建省福州市仓山区 盖山镇 阳岐村 鳌头山（今严复公园内）"},"note":{"zh-Hans":"第六批国保「严复故居和墓」的墓。1910 年严复生前自营生圹，1921 年归葬于此；墓前石屏刻「惟适之安」，墓碑书「清侯官严几道先生之寿域」。墓在阳岐，故居在城内郎官巷，两处相隔十余公里；核心墓区只在节假日开放。"},"status":"extant","since":"1910","sources":[{"ref":"source.国保名录"},{"ref":"source.web.严复墓"}]}],"space":{"points":[{"name":{"zh-Hans":"福州"},"coord":[119.3,26.08]},{"name":{"zh-Hans":"天津"},"coord":[117.2,39.13],"role":"activity","time":{"kind":"interval","start":"1880","end":"1900","precision":"year"}}]},"relations":[{"type":"subordinate_of","target":"person.lihongzhang","note":{"zh-Hans":"北洋水师学堂总办，隶李鸿章"},"source":["source.legacy.person"]},{"type":"studied_at","target":"institution.fuzhou-chuanzheng"},{"type":"taught_at","target":"institution.tianjin-shuishi-xuetang"},{"type":"participant","target":"event.1898.天津"},{"type":"participant","target":"event.1875.船政留欧"}]},{"id":"person.zhangjian","type":"person","labels":{"zh-Hans":"张謇","en":"Zhang Jian"},"aliases":[{"zh-Hans":"实业救国"}],"time":{"kind":"interval","start":"1853","end":"1926","precision":"year"},"nationality":"china","roles":[],"sources":[{"ref":"source.legacy.person"}],"summary":{"zh-Hans":"江苏南通人，1894 年状元，1895 年筹办大生纱厂，是「实业救国」的代表人物。"},"visits":[{"kind":"grave","name":{"zh-Hans":"张謇墓（南通啬园）"},"address":{"zh-Hans":"江苏省南通市崇川区南郊路 150 号 啬园"},"note":{"zh-Hans":"1926 年按张謇生前遗愿葬于南通南郊，墓园后扩为啬园（4A、全国重点文保），园内还有张氏飨堂；他办的大生纱厂、师范学校与博物苑都在南通城内，可连成一条「张謇线」。"},"status":"extant","since":"1926","sources":[{"ref":"source.web.啬园"}]},{"kind":"museum","name":{"zh-Hans":"南通博物苑"},"address":{"zh-Hans":"江苏省南通市崇川区 濠南路 19 号"},"note":{"zh-Hans":"第三批国保（1905 年）。张謇 1905 年创办，是中国人自办的第一座公共博物馆，今为国家一级博物馆；濠南别业（张謇故居）也在苑内。与南郊啬园的张謇墓一北一南，半天可串成一条线。"},"status":"extant","since":"1905","sources":[{"ref":"source.国保名录"},{"ref":"source.web.南通博物苑"}]}],"space":{"points":[{"name":{"zh-Hans":"南通"},"coord":[120.89,31.98]},{"name":{"zh-Hans":"南通"},"coord":[120.89,31.98],"role":"activity","time":{"kind":"interval","start":"1895","end":"1926","precision":"year"}}]},"relations":[{"type":"custom:colleague_of","target":"person.zhou-xuexi","note":{"zh-Hans":"南张北周"},"source":["source.wiki.周学熙","source.legacy.person"]},{"type":"custom:colleague_of","target":"person.muouchu","note":{"zh-Hans":"棉纺同业：大生与德大、厚生纱厂"},"source":["source.legacy.person"]},{"type":"member_of","target":"group.shijia"},{"type":"custom:director_of","target":"org.yubeilixian"},{"type":"participant","target":"event.1899.通州唐闸今江苏南通"},{"type":"participant","target":"event.1912.南京临时政府"},{"type":"participant","target":"event.1909.咨议局成立"},{"type":"participant","target":"event.1909.地方自治"},{"type":"participant","target":"event.1910.国会请愿"},{"type":"custom:director_of","target":"org.jiaoyuhui"},{"type":"founded","target":"org.nonghui"},{"type":"participant","target":"event.1909.北京"},{"type":"participant","target":"event.1913.熊希龄内阁"}]},{"id":"person.yuanshikai","type":"person","labels":{"zh-Hans":"袁世凯","en":"Yuan Shikai"},"aliases":[{"zh-Hans":"慰亭"},{"zh-Hans":"袁项城"},{"zh-Hans":"袁大总统"}],"time":{"kind":"interval","start":"1859","end":"1916","precision":"year"},"nationality":"china","roles":[],"sources":[{"ref":"source.legacy.person"},{"ref":"source.textbook-8a"}],"summary":{"zh-Hans":"北洋新军的缔造者。辛亥革命后出任临时大总统，1913 年镇压二次革命，1915 年称帝失败，次年病故，此后北洋分裂为各系军阀。"},"space":{"points":[{"name":{"zh-Hans":"河南项城"},"coord":[114.9,33.45]},{"name":{"zh-Hans":"天津"},"coord":[117.2,39.13],"role":"activity","time":{"kind":"interval","start":"1895","end":"1899","precision":"year"}},{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92],"role":"activity","time":{"kind":"interval","start":"1912","end":"1916","precision":"year"}}]},"tags":["人物","教材"],"visits":[{"kind":"grave","name":{"zh-Hans":"袁林（袁世凯墓）"},"address":{"zh-Hans":"河南省安阳市北关区胜利路洹水北岸太平庄"},"note":{"zh-Hans":"1916 年 8 月始建、1918 年 6 月建成，北洋政府按总统之礼营造，中西合璧的陵园格局在近代陵墓里很少见。2013 年列为全国重点文物保护单位，现为 3A 景区。"},"since":"1918","status":"extant","sources":[{"ref":"source.web.袁林"}]},{"kind":"site","name":{"zh-Hans":"袁世凯行宫"},"address":{"zh-Hans":"河南省周口市项城市水寨街道南大街北段"},"note":{"zh-Hans":"第三批河南省保。1917 年建，在项城老城南大街北段；项城是袁世凯的祖籍地（其出生地在项城袁寨，另有故居），行宫与袁林是两处：一在项城、一在安阳，别混。"},"status":"extant","sources":[{"ref":"source.省保名录"},{"ref":"source.web.袁世凯行宫"}],"since":"1917"}],"relations":[{"type":"subordinate_of","target":"person.lihongzhang","note":{"zh-Hans":"李鸿章保举袁世凯编练新军"},"source":["source.legacy.person"]},{"type":"subordinate_of","target":"person.ronglu","note":{"zh-Hans":"小站练兵，隶荣禄节制"},"source":["source.《清史稿》"]},{"type":"custom:colleague_of","target":"person.yikuang","note":{"zh-Hans":"清末新政与辛亥南北议和中合作"},"source":["source.《辛亥革命史》"]},{"type":"member_of","target":"group.beiyang"},{"type":"participant","target":"event.1882.汉城"},{"type":"participant","target":"event.1884.汉城"},{"type":"participant","target":"event.1912.北京"},{"type":"participant","target":"event.1915.北京"},{"type":"participant","target":"event.1916.北京"},{"type":"participant","target":"event.sino-russian-declaration-1913"},{"type":"participant","target":"event.1902.天津巡警"},{"type":"participant","target":"event.1903.练兵处"},{"type":"participant","target":"event.1904.营制饷章"},{"type":"participant","target":"event.1905.废科举"},{"type":"participant","target":"event.1900.东南互保"},{"type":"participant","target":"event.1894.汉城"},{"type":"participant","target":"event.1915.昆明"},{"type":"participant","target":"event.1912.临时大总统"},{"type":"participant","target":"event.1913.正式大总统"},{"type":"participant","target":"event.1915.洪宪帝制"}]},{"id":"person.wang-daxie","type":"person","labels":{"zh-Hans":"汪大燮","en":"Wang Daxie"},"aliases":[{"zh-Hans":"汪伯棠"},{"zh-Hans":"汪伯唐"},{"zh-Hans":"汪尧俞"}],"time":{"kind":"interval","start":"1859","end":"1929","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"杭州"},"coord":[120.16,30.29]}]},"summary":{"zh-Hans":"浙江钱塘（今杭州）人，原名尧俞，字伯唐（一作伯棠）。清末任驻英公使、外务部右侍郎、驻日公使。1913 年入熊希龄内阁任教育总长，入阁前要求与梁启超、张謇同进退；1914 年任参政院副院长。1916 年任段祺瑞内阁交通总长，1917 年任外交总长，段辞职后代理国务总理数日。1918 年任外交委员会委员长，主持审议对德和约相关案件。1920 年起任中国红十字会会长。"},"sources":[{"ref":"source.《北洋军阀史话》"},{"ref":"source.web.汪大燮生平"}],"tags":["外交","北洋"],"relations":[{"type":"custom:colleague_of","target":"person.xiong-xiling","note":{"zh-Hans":"熊邀其入阁，他要求与梁启超、张謇一同进退，遂任教育总长"},"source":["source.《北洋军阀史话》"]},{"type":"custom:colleague_of","target":"person.liangqichao","note":{"zh-Hans":"同入熊希龄「名流内阁」，熊下台时随之一同去职"},"source":["source.《北洋军阀史话》"]},{"type":"custom:colleague_of","target":"person.zhangjian","note":{"zh-Hans":"同入熊希龄「名流内阁」，同进同退"},"source":["source.《北洋军阀史话》"]},{"type":"subordinate_of","target":"person.duanqirui","note":{"zh-Hans":"1916 年段内阁交通总长；1917 年段再组阁时出任外交总长，段辞职后代理国务总理"},"source":["source.《北洋军阀史话》"]},{"type":"subordinate_of","target":"person.liyuanhong","note":{"zh-Hans":"1914 年参政院副院长，院长为黎元洪"},"source":["source.《北洋军阀史话》"]},{"type":"member_of","target":"group.minguo-waijiao"},{"type":"participant","target":"event.1913.熊希龄内阁"}]},{"id":"person.tian-wenlie","type":"person","labels":{"zh-Hans":"田文烈","en":"Tian Wenlie"},"aliases":[{"zh-Hans":"田焕亭"}],"time":{"kind":"interval","start":"1858","end":"1924","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"汉阳"},"coord":[114.22,30.56]}]},"summary":{"zh-Hans":"湖北汉阳人，字焕亭。早年入袁世凯幕，随使朝鲜，回国后任北洋水师学堂教习、小站文案，后以道员署通永镇总兵，1909 年升陆军部副大臣。民国后历任袁世凯总统府顾问、山东民政长、河南民政长兼都督、河南巡按使加将军衔。1917 年 12 月入王士珍内阁任农商总长，任内以农商总长身份与曹汝霖共同签下西原借款中的「金矿森林借款」。此后内阁频更而地位不动，一度署内务总长、交通总长，1922 年因病辞任，1924 年卒于北京。"},"sources":[{"ref":"source.web.田文烈生平"},{"ref":"source.《北洋军阀史话》"}],"tags":["政治","北洋"],"relations":[{"type":"subordinate_of","target":"person.yuanshikai","note":{"zh-Hans":"入袁世凯幕，随使朝鲜，后任小站文案、陆军部副大臣"},"source":["source.web.田文烈生平"]},{"type":"participant","target":"event.1917.西原借款"},{"type":"participant","target":"event.1917.王士珍内阁"}]},{"id":"person.mingyi","type":"person","labels":{"zh-Hans":"明谊","en":"Ming Yi"},"aliases":[{"zh-Hans":"古渔"}],"time":{"kind":"interval","start":"1855","end":"1866","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.9]}]},"summary":{"zh-Hans":"蒙古正黄旗人，托克托莫特氏，字古渔。1855 年任塔尔巴哈台参赞大臣，1858 年与俄方议定《塔尔巴哈台议订补贴条约》；1859 年升乌里雅苏台将军，1860 年任钦差勘办西北界事宜大臣，1864 年 10 月在塔尔巴哈台与巴布科夫、札哈罗夫签订《中俄勘分西北界约记》。1866 年病免。生卒年不详，此处时间段取其任职到开缺的可考区间。"},"sources":[{"ref":"source.wiki.明谊"}],"tags":["外交","界约"],"relations":[{"type":"participant","target":"event.treaty.tacheng-1864"},{"type":"participant","target":"event.treaty.kebuduo-1869"},{"type":"participant","target":"event.treaty.wuliyasutai-1869"},{"type":"participant","target":"event.treaty.tarbagatai-1870"}]},{"id":"person.tan-tingxiang","type":"person","labels":{"zh-Hans":"谭廷襄","en":"Tan Tingxiang"},"aliases":[{"zh-Hans":"谭竹崖"}],"time":{"kind":"interval","start":"1857","end":"1858","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"绍兴"},"coord":[120.58,30]}]},"summary":{"zh-Hans":"浙江山阴人，字竹崖。道光十三年进士；咸丰七年署直隶总督，1858 年英法联军进犯大沽时力主妥协、不事战守，大沽失守、天津被逼议和，旋被劾夺职。后署陕西巡抚、山东巡抚。卒于 1870 年，生年不详。"},"sources":[{"ref":"source.wiki.谭廷襄"}],"tags":["外交","直隶"],"relations":[{"type":"participant","target":"event.1858.大沽口"}]},{"id":"person.terauchi","type":"person","labels":{"zh-Hans":"寺内正毅","en":"Terauchi Masatake"},"time":{"kind":"interval","start":"1852","end":"1919","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"汉城"},"coord":[126.98,37.57]}]},"summary":{"zh-Hans":"日本陆军大将、政治家。1910 年 5 月任第三任韩国统监，主持与朝鲜总理大臣李完用签订《日韩合并条约》，8 月 29 日公布，朝鲜沦为日本殖民地；同年出任首任朝鲜总督。后任日本首相（1916–1918）。"},"sources":[{"ref":"source.wiki.寺内正毅"}],"tags":["日本","朝鲜"],"relations":[{"type":"participant","target":"event.1910.汉城"}]},{"id":"person.kamio-mitsumasa","type":"person","labels":{"zh-Hans":"神尾光臣","en":"Kamio Mitsumasa"},"aliases":[{"zh-Hans":"神尾光臣"}],"time":{"kind":"interval","start":"1855","end":"1927","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"青岛"},"coord":[120.38,36.07]}]},"summary":{"zh-Hans":"日本陆军将领（1855–1927）。甲午战争时任参谋本部大佐，奉命专探李鸿章行止。1914 年任第十八师团长，率日军自龙口登陆围攻青岛，11 月 10 日与德国胶州总督华德克举行「移交礼」，第一次世界大战在远东的唯一战役就此结束。"},"sources":[{"ref":"source.《晚清人物丛考》"},{"ref":"s