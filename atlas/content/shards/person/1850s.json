els":{"zh-Hans":"蓝建枢"},"time":{"kind":"interval","start":"1855","end":"1927","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"闽县"},"coord":[119.3,26.08]}]},"summary":{"zh-Hans":"福建闽县人，北洋海军军官；参加威海卫之战，后任海军将领。"},"sources":[{"ref":"source.《甲午战争史》"}],"tags":["人物","甲午","海军"],"relations":[{"type":"participant","target":"event.1895.刘公岛今山东威海"}]},{"id":"person.sa-zhenbing","type":"person","labels":{"zh-Hans":"萨镇冰","en":"Sa Zhenbing"},"aliases":[{"zh-Hans":"鼎铭"}],"time":{"kind":"interval","start":"1859","end":"1952","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"闽县"},"coord":[119.3,26.08]}]},"summary":{"zh-Hans":"福建闽县人，字鼎铭，雁门萨氏。清末海军大臣、民国海军总长，一度代理国务总理，是跨越清末、北洋、国民政府三朝的海军元老；1952 年在福州去世。"},"sources":[{"ref":"source.wiki.萨镇冰"}],"tags":["海军","清末","民国"],"visits":[{"kind":"residence","name":{"zh-Hans":"萨氏民居（朱紫坊）"},"address":{"zh-Hans":"福建省福州市鼓楼区朱紫坊"},"note":{"zh-Hans":"萨镇冰家族的宅院，在朱紫坊街区（与三坊七巷相邻），2006 年列为全国重点文物保护单位。海军元老萨镇冰从这里走出，甲午时守威海卫、后来做过福建省长。国保名录作「三坊七巷和朱紫坊建筑群」（第六批）。"},"status":"extant","sources":[{"ref":"source.web.三坊七巷建筑群"}]}],"relations":[{"type":"member_of","target":"group.beiyang-haijun"},{"type":"participant","target":"event.1911.阳夏"},{"type":"participant","target":"event.1895.刘公岛今山东威海"},{"type":"participant","target":"event.1875.船政留欧"}]},{"id":"person.liu-yishun","type":"person","labels":{"zh-Hans":"刘仪顺","en":"Liu Yishun"},"time":{"kind":"interval","start":"1857","end":"1868","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"邵阳"},"coord":[111.47,27.24]}]},"summary":{"zh-Hans":"生年不详。原籍湖南宝庆，随父迁四川宜宾，白莲教徒，创灯花教（斋教）。1857 年在贵州思南起兵，称白号军；1859 年拥立朱明月，改元嗣统。1868 年起义失败，与朱明月先后被捕杀。此处时间段取其起事到被杀的可考活动区间。"},"sources":[{"ref":"source.wiki.刘仪顺"}],"tags":["白莲教","起义"],"relations":[{"type":"custom:leader_of","target":"org.gz-haojun"},{"type":"member_of","target":"org.bailianjiao"}]},{"id":"person.liu-shiduan","type":"person","labels":{"zh-Hans":"刘士端","en":"Liu Shiduan"},"time":{"kind":"interval","start":"1853","end":"1896","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"曹县"},"coord":[115.55,34.83]}]},"summary":{"zh-Hans":"山东曹县烧饼刘庄人，秀才出身，习金钟罩。1894 年前后在鲁西南创立大刀会，以「保卫身家」为号，会众遍及苏鲁豫皖，1896 年达十万之众。同年因反洋教被山东当局诱捕处死。"},"sources":[{"ref":"source.wiki.刘士端"}],"tags":["会党","反洋教"],"relations":[{"type":"founded","target":"org.dadaohui"},{"type":"founded","target":"org.sd-dadaohui"}]},{"id":"person.yu-dongchen","type":"person","labels":{"zh-Hans":"余栋臣","en":"Yu Dongchen"},"aliases":[{"zh-Hans":"余蛮子"}],"time":{"kind":"interval","start":"1851","end":"1912","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"大足"},"coord":[105.72,29.7]}]},"summary":{"zh-Hans":"四川大足龙水镇人，以挑煤为业，臂力过人，人称「余蛮子」。1886、1888、1890 年三次率众捣毁龙水镇教堂；1898 年被捕后为民众劫狱救出，8 月再举义旗，以「顺清灭洋」为号，转战川东。起义失败后隐退，1912 年卒。"},"sources":[{"ref":"source.wiki.余栋臣"}],"tags":["反洋教","起义"],"visits":[{"kind":"residence","name":{"zh-Hans":"余栋臣故居及墓"},"address":{"zh-Hans":"重庆市大足区"},"note":{"zh-Hans":"市级文物保护单位（重庆市保第一批；直辖市市级即省级）。余栋臣 1890 年领导大足反洋教起义；故居及墓在大足区。"},"status":"extant","sources":[{"ref":"source.省保名录"}]}],"relations":[{"type":"custom:leader_of","target":"org.yu-dongchen"}]},{"id":"person.li-pingshu","type":"person","labels":{"zh-Hans":"李平书","en":"Li Pingshu"},"aliases":[{"zh-Hans":"李钟珏"}],"time":{"kind":"interval","start":"1854","end":"1927","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.49,31.4]}]},"summary":{"zh-Hans":"江苏宝山高桥镇人，原名安曾，后改名钟珏，银行家、上海自治领袖。1903 年任江南制造局提调，后主持上海城厢内外总工程局；1909 年改设城厢内外自治公所，任总董，办理学务、卫生、道路与慈善。辛亥上海光复后任沪军都督府民政总长。"},"sources":[{"ref":"source.wiki.李平书"}],"tags":["自治","上海","金融"],"relations":[{"type":"custom:director_of","target":"org.zizhigongsuo"}]},{"id":"person.hsu-shih-chang","type":"person","labels":{"zh-Hans":"徐世昌","en":"Hsu Shih-chang"},"time":{"kind":"interval","start":"1855","end":"1939","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"卫辉"},"coord":[114.059,35.404]}]},"summary":{"zh-Hans":"卫辉人。袁世凯幕僚，1918—1922年任北洋政府大总统。"},"sources":[{"ref":"source.wiki.徐世昌"}],"tags":["政治"],"visits":[{"kind":"residence","name":{"zh-Hans":"徐世昌公馆"},"address":{"zh-Hans":"河南省新乡市辉县市城区牌坊街东段北侧（原公安局院内）"},"note":{"zh-Hans":"第五批河南省保（2008 年公布）。徐世昌在辉县的办公与居所，民国初年建，占地二十余亩，原有五院，现存正院过厅、正房与左右厢房四座二十四间；他在城西水竹村另有「归田别墅」，距百泉约三公里。公馆现由单位使用，只能看沿街外观。"},"status":"extant","sources":[{"ref":"source.省保名录"},{"ref":"source.web.徐世昌公馆"}]}],"relations":[{"type":"member_of","target":"group.beiyang"},{"type":"participant","target":"event.1903.练兵处"},{"type":"participant","target":"event.1905.巡警部"},{"type":"participant","target":"event.1905.五大臣出洋"},{"type":"participant","target":"event.1911.皇族内阁"},{"type":"participant","target":"event.1907.东三省新政"},{"type":"participant","target":"event.1914.政事堂"},{"type":"participant","target":"event.1918.钱能训内阁"}]},{"id":"person.lu-rongting","type":"person","labels":{"zh-Hans":"陆荣廷","en":"Lu Rongting"},"time":{"kind":"interval","start":"1859","end":"1928","precision":"year"},"summary":{"zh-Hans":"武鸣人。旧桂系首领，曾任两广巡阅使。活跃于 1911—1924 年。"},"sources":[{"ref":"source.wiki.陸榮廷"}],"tags":["政治","军事"],"space":{"points":[{"name":{"zh-Hans":"武鸣"},"coord":[108.273,23.159]}]},"relations":[{"type":"rival_of","target":"person.lizongren","note":{"zh-Hans":"旧桂系与新桂系"},"source":["source.legacy.person","source.wiki.陸榮廷"]},{"type":"member_of","target":"group.warlords"},{"type":"participant","target":"event.1911.各省光复"},{"type":"participant","target":"event.1917.广州"}]},{"id":"person.gu-hongming","type":"person","labels":{"zh-Hans":"辜鸿铭","en":"Gu Hongming"},"time":{"kind":"interval","start":"1857","end":"1928","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"槟城"},"coord":[100.365,5.403]}]},"summary":{"zh-Hans":"槟城人。以英文著《中国人的精神》，辩护传统文化。"},"sources":[{"ref":"source.wiki.辜鸿铭"}],"tags":["文化保守","思想"],"relations":[{"type":"member_of","target":"group.xuezhe"}]},{"id":"person.liu-e","type":"person","labels":{"zh-Hans":"刘鹗","en":"Liu E"},"time":{"kind":"interval","start":"1857","end":"1909","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"丹徒区"},"coord":[119.429,32.134]}]},"summary":{"zh-Hans":"丹徒区人。《老残游记》作者。活跃于 1903—1909 年。"},"sources":[{"ref":"source.wiki.刘鹗"}],"tags":["小说","文学"],"relations":[{"type":"member_of","target":"group.wanqing-xiaoshuo"}]},{"id":"person.feng-guozhang","type":"person","labels":{"zh-Hans":"冯国璋","en":"Feng Guozhang"},"time":{"kind":"interval","start":"1859","end":"1921","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"河间"},"coord":[116.09,38.445]}]},"summary":{"zh-Hans":"河间人。直系首领，1917年代理大总统。"},"sources":[{"ref":"source.wiki.馮國璋"}],"tags":["政治","军事"],"visits":[{"kind":"residence","name":{"zh-Hans":"冯国璋旧居（冯家花园）"},"address":{"zh-Hans":"天津市河北区 民主道 52—56 号（含海河东路花园巷一带）"},"note":{"zh-Hans":"市级文物保护单位（天津市保第四批；直辖市的市级即省级）。天津市文物保护单位。1912 年建、1915 年由德国建筑师扩建，人称「冯家花园」：砖木结构、奥式风格，楼房 110 间、平房 54 间，占地 6.376 市亩；后花园一度改煤厂、又成里巷（冯家胡同，1982 年更名花园巷）。今为机关办公用房，不对外开放，只能看沿街外立面。"},"status":"extant","since":"1912","sources":[{"ref":"source.web.冯国璋旧居"},{"ref":"source.省保名录"}]},{"kind":"residence","name":{"zh-Hans":"冯国璋故居（将军第）"},"address":{"zh-Hans":"河北省沧州市河间市西诗经村（河间市区以北）"},"note":{"zh-Hans":"第五批河北省保（2008 年公布）。1913 年 2 月始建、1915 年 12 月竣工，占地近百亩、厅堂屋阁四百余间，时称「将军第」「总统府」；「文革」中大部分损毁，现存将军第门楼、地下室、石雕与古树。同村还有 1917 年始建的冯国璋国葬墓，地面建筑多已不存。"},"status":"extant","since":"1913","sources":[{"ref":"source.省保名录"},{"ref":"source.web.冯国璋将军第"}]}],"relations":[{"type":"subordinate_of","target":"person.yuanshikai","note":{"zh-Hans":"北洋三杰，江苏都督"},"source":["source.wiki.馮國璋","source.legacy.person"]},{"type":"member_of","target":"group.beiyang"},{"type":"member_of","target":"group.warlords"},{"type":"participant","target":"event.1911.阳夏"},{"type":"participant","target":"event.1917.广州"},{"type":"participant","target":"event.1917.冯国璋代理"}]},{"id":"person.liu-buchan","type":"person","labels":{"zh-Hans":"刘步蟾","en":"Liu Buchan"},"aliases":[{"zh-Hans":"子香"}],"time":{"kind":"interval","start":"1852","end":"1895","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"侯官"},"coord":[119.3,26.08]}]},"summary":{"zh-Hans":"福建侯官人，字子香，北洋水师旗舰定远舰管带，官至右翼总兵、记名提督；1895 年威海卫之战中下令炸沉定远，随后自尽。"},"sources":[{"ref":"source.wiki.劉步蟾"}],"tags":["海军","北洋水师","甲午"],"relations":[{"type":"member_of","target":"group.beiyang-haijun"},{"type":"participant","target":"event.1894.大东沟"},{"type":"participant","target":"event.1895.刘公岛今山东威海"}]},{"id":"person.chen-yan","type":"person","labels":{"zh-Hans":"陈衍","en":"Chen Yan"},"aliases":[{"zh-Hans":"陈石遗"},{"zh-Hans":"石遗老人"}],"time":{"kind":"interval","start":"1856","end":"1937","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"福州"},"coord":[119.3,26.08]}]},"summary":{"zh-Hans":"福建侯官人，字叔伊，号石遗。光绪八年举人，曾应刘铭传之邀入台湾幕府，后任学部主事、京师大学堂文科教习；民国后主编《福建通志》，是同光体诗派的理论家，著《石遗室诗话》《石遗室诗集》，晚年讲学苏州、无锡。自题「谁知五柳孤松客，却住三坊七巷间」。故居在光禄坊大光里（旧称文儒坊三官堂），2009 年列入省保。 "},"visits":[{"kind":"residence","name":{"zh-Hans":"陈衍故居"},"address":{"zh-Hans":"福建省福州市鼓楼区 大光里 8 号（旧称文儒坊三官堂）"},"note":{"zh-Hans":"福建省文物保护单位（第七批，2009 年）。省保名录的所在地写作「文儒坊大光里」，福州市名城保护名录写作「光禄坊大光里」，两说并存——大光里本在文儒坊与光禄坊之间。宅在巷内，是陈衍晚年回福州后的居所；他在《石遗室诗话》里记三坊七巷人物，自己也是这条坊巷的注脚。"},"status":"extant","since":"1856","sources":[{"ref":"source.web.福州名城保护名录"},{"ref":"source.web.三坊七巷"}]}],"sources":[{"ref":"source.web.福州名城保护名录"},{"ref":"source.web.三坊七巷"}],"tags":["诗学","福州"]},{"id":"person.lin-shu","type":"person","labels":{"zh-Hans":"林纾","en":"Lin Shu"},"aliases":[{"zh-Hans":"林琴南"},{"zh-Hans":"林畏庐"}],"time":{"kind":"interval","start":"1852","end":"1924","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"福州"},"coord":[119.32,26.06]}]},"summary":{"zh-Hans":"福建福州人，字琴南，号畏庐。不懂外文，却靠与人口译合作，用古文译出《巴黎茶花女遗事》《黑奴吁天录》等一百七十余种小说，是晚清民初影响最大的翻译家之一，也写作古文、诗与笔记。1924 年病逝。 "},"visits":[{"kind":"residence","name":{"zh-Hans":"林纾故居"},"address":{"zh-Hans":"福建省福州市鼓楼区六一中路 40 号 莲宅村内"},"note":{"zh-Hans":"市级文物保护单位（福州市第六批，2015 年公布）。清代民居，占地 348 平方米，坐西向东、门廊—天井—厅堂一进进进去；福州市级文保。免费，8:30–12:00、14:00–17:00，在莲宅村巷子里，不太好找。"},"status":"extant","sources":[{"ref":"source.web.林纾故居"}]}],"sources":[{"ref":"source.web.林纾故居"}],"tags":["文学","翻译","福州"]},{"id":"person.shen-zengzhi","type":"person","labels":{"zh-Hans":"沈曾植","en":"Shen Zengzhi"},"time":{"kind":"interval","start":"1850","end":"1922","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"嘉兴"},"coord":[120.76,30.76]}]},"summary":{"zh-Hans":"浙江嘉兴人。学者、书法家，清末民初遗老，兼通西北史地。"},"sources":[{"ref":"source.省保名录"}],"tags":["学术"],"visits":[{"kind":"residence","name":{"zh-Hans":"沈曾植旧居"},"address":{"zh-Hans":"浙江省嘉兴市南湖区建设街道"},"note":{"zh-Hans":"省级文物保护单位（第六批）。沈曾植旧居在嘉兴南湖区。"},"status":"extant","sources":[{"ref":"source.省保名录"}]}]},{"id":"person.tongzhi","type":"person","labels":{"zh-Hans":"同治帝","en":"Tongzhi Emperor"},"time":{"kind":"interval","start":"1856","end":"1875","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"roles":["皇帝"],"summary":{"zh-Hans":"清穆宗，1861–1875 在位。洋务运动起步，1864 年湘军攻陷天京；1875 崩。"},"sources":[{"ref":"source.《清史稿》"}],"tags":["人物","清朝","皇帝"],"visits":[{"kind":"grave","name":{"zh-Hans":"惠陵（同治帝陵）"},"address":{"zh-Hans":"河北省唐山市遵化市清东陵"},"note":{"zh-Hans":"属全国重点文物保护单位「清东陵」（第一批）的组成部分。同治帝 1874 年病逝、1875 年葬入惠陵，与皇后阿鲁特氏合葬；惠陵是清东陵最东边的一座帝陵。"},"status":"extant","sources":[{"ref":"source.国保名录"}],"since":"1875"}],"relations":[{"type":"custom:child_of","target":"person.xianfeng","note":{"zh-Hans":"咸丰长子，1861 年继位"},"source":["source.《清史稿》"]},{"type":"custom:child_of","target":"person.cixi","note":{"zh-Hans":"慈禧亲生子（载淳）"},"source":["source.《清史稿》"]},{"type":"custom:child_of","target":"person.ci-an","note":{"zh-Hans":"慈安为咸丰皇后，同治嫡母"},"source":["source.《清史稿》"]},{"type":"member_of","target":"group.qing-huanshi"},{"type":"participant","target":"event.1861.北京"},{"type":"participant","target":"event.1861.两宫垂帘"},{"type":"participant","target":"event.1873.同治亲政"}]},{"id":"person.tangshouqian","type":"person","labels":{"zh-Hans":"汤寿潜"},"time":{"kind":"interval","start":"1856","end":"1917","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"萧山"},"coord":[120.26,30.18]}]},"summary":{"zh-Hans":"浙江萧山人，立宪派，浙江光复后任都督，南京临时政府交通总长。"},"sources":[{"ref":"source.《辛亥革命史》"}],"tags":["人物","辛亥革命","浙江"],"visits":[{"kind":"residence","name":{"zh-Hans":"汤寿潜故居"},"address":{"zh-Hans":"浙江省杭州市萧山区进化镇大汤坞村"},"note":{"zh-Hans":"第八批浙江省保