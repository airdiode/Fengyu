22.79]}]},"summary":{"zh-Hans":"孙中山派郑士良在惠州发动起义，义军一度发展至两万余人，终因粮械不继失败。"},"category":"war","sources":[{"ref":"source.《义和团运动史》"}],"tags":["庚子","惠州"]},{"id":"event.1900.史坚如","type":"event","labels":{"zh-Hans":"史坚如谋炸德寿"},"time":{"kind":"interval","start":"1900-10","end":"1900-10","precision":"month"},"space":{"points":[{"name":{"zh-Hans":"广州"},"coord":[113.38,23.13]}]},"summary":{"zh-Hans":"史坚如谋炸广东巡抚德寿，以响应惠州起义，事败被捕就义。"},"category":"politics","sources":[{"ref":"source.《义和团运动史》"}],"tags":["庚子","暗杀"]},{"id":"event.1907-nvzi-xuezhang","type":"event","labels":{"zh-Hans":"学部奏定女子学堂章程"},"time":{"kind":"instant","at":"1907-03","precision":"month"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"category":"education","summary":{"zh-Hans":"学部奏定《女子小学堂章程》《女子师范学堂章程》，女子教育第一次被纳入国家学制；章程并规定女学生一律禁止缠足。"},"sources":[{"ref":"source.web.女子学堂章程1907"},{"ref":"source.《第一次教育统计图表》"}],"tags":["教育","女性","制度"],"metrics":[{"key":"girls-schools","name":{"zh-Hans":"全国女学堂"},"unit":"所","points":[{"year":1907,"value":428}]},{"key":"girls-students","name":{"zh-Hans":"女学生"},"unit":"人","points":[{"year":1907,"value":15496}]},{"key":"girls-teachers","name":{"zh-Hans":"女学堂教习"},"unit":"人","points":[{"year":1907,"value":1501}]},{"key":"girls-jiangsu","name":{"zh-Hans":"女学生（江苏，含上海）"},"unit":"人","points":[{"year":1907,"value":4198}]},{"key":"girls-zhili","name":{"zh-Hans":"女学生（直隶，含天津）"},"unit":"人","points":[{"year":1907,"value":2523}]},{"key":"girls-sichuan","name":{"zh-Hans":"女学生（四川，含重庆）"},"unit":"人","points":[{"year":1907,"value":2246}]}]},{"id":"event.chongzheng-1902","type":"event","labels":{"zh-Hans":"崇正学堂开学","en":"Chongzheng School opens"},"time":{"kind":"instant","at":"1902-10-31","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"喀喇沁右翼旗王府"},"coord":[118.55,41.88]}]},"category":"education","summary":{"zh-Hans":"贡桑诺尔布在喀喇沁右翼旗王府西院创办崇正学堂并自任校长，是全蒙古第一所近代学堂；课程除蒙汉文与四书五经外，还有日语、算术、地理、历史、书法、绘画、音乐、体育。"},"sources":[{"ref":"source.wiki.贡桑诺尔布"}],"tags":["蒙古","教育","贡王新政"]},{"id":"event.yuzheng-1903","type":"event","labels":{"zh-Hans":"毓正女子学堂开办","en":"Yuzheng Girls' School opens"},"time":{"kind":"instant","at":"1903","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"喀喇沁右翼旗王府"},"coord":[118.55,41.88]}]},"category":"education","summary":{"zh-Hans":"贡桑诺尔布在崇正学堂之后开办的蒙古族第一所女子学堂，课程含蒙、汉、日文与历史、地理、数学、家政、缝纫、自然、绘画、音乐；经费由族中富人捐资，清政府赐「壶教畅明」匾额。"},"sources":[{"ref":"source.wiki.贡桑诺尔布"}],"tags":["蒙古","教育","女子教育"]},{"id":"event.1907.日俄密约","type":"event","labels":{"zh-Hans":"日俄第一次《密约》划定南满北满"},"aliases":[{"zh-Hans":"日俄密约"},{"zh-Hans":"第一次日俄密约"}],"time":{"kind":"instant","at":"1907-07-30","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"珲春"},"coord":[130.365,42.867]}]},"category":"diplomacy","summary":{"zh-Hans":"日俄战争后，日本与俄国于 1907 年 7 月 30 日在圣彼得堡签订《日俄协定》，其中秘密附款把中国东北划为南满、北满：分界线自俄朝边界西北端起，经珲春、镜泊湖极北端、秀水镇（榆树），沿第二松花江至嫩江口，溯嫩江至洮儿河口，再沿洮儿河上溯至东经 122 度；线南为日本势力范围，线北为俄国势力范围。两国互相承认在朝鲜、外蒙古的特殊利益，中国政府被完全排除在外。此后 1910、1912、1916 年又签三次密约，把内蒙古也划入势力范围。1917 年俄国革命后苏俄宣布废除，但南北满格局延续到 1945 年。签订地在圣彼得堡，图上标在分界线南端珲春。"},"treaty":{"name":"日俄密约（第一次）","signed":1907,"place":"圣彼得堡","parties":["日本","俄国"],"ceded":[],"indemnity":null,"ports":[],"privileges":["划南满（日）/ 北满（俄）势力范围","俄国承认日本在朝鲜的既得利益","日本承认俄国在外蒙古的特殊利益","中国政府被排除在外"]},"tags":["密约","外交","日俄","满洲","势力范围"],"sources":[{"ref":"source.《六十年来中国与日本》"}]},{"id":"event.1904.拉萨","type":"event","labels":{"zh-Hans":"《拉萨条约》：荣赫鹏入藏，清廷拒签"},"time":{"kind":"instant","at":"1904-09-07","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"拉萨"},"coord":[91.14,29.65]}]},"category":"war","treaty":{"name":"拉萨条约","signed":1904,"place":"拉萨","parties":["英国","西藏噶厦"],"ceded":[],"indemnity":{"amount":750,"unit":"万卢比"},"ports":["亚东","江孜","噶大克"],"privileges":["开三处商埠","拆除自印度至江孜的炮台","英军驻春丕"]},"summary":{"zh-Hans":"1903 年底英军第二次侵藏，1904 年 8 月攻入拉萨，9 月 7 日荣赫鹏迫使噶厦在布达拉宫签订《拉萨条约》：赔款七百五十万卢比、开亚东、江孜、噶大克三处商埠、拆除炮台、英军驻春丕。驻藏大臣有泰拒签，清政府亦不承认——条约只有英方与噶厦的签字。"},"relations":[{"type":"custom:继于","target":"event.1893.亚东"}],"sources":[{"ref":"source.wiki.拉萨条约"}],"tags":["西藏","英国","条约","军事"]},{"id":"event.treaty.zangyin-1906","type":"event","labels":{"zh-Hans":"《中英续订藏印条约》：英承认中国对藏宗主权"},"time":{"kind":"instant","at":"1906-04-27","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.9]}]},"category":"diplomacy","summary":{"zh-Hans":"1906 年 4 月 27 日，清政府与英国在北京签订《续订藏印条约》：以《拉萨条约》为附约，但英国承诺「不兼并西藏领土、不干涉西藏内政」，承认中国对西藏的宗主权；赔款由清政府三年内付清（减为二百五十万卢比），英军提前撤出春丕。清廷以此挽回了对藏主权的一部分。"},"relations":[{"type":"custom:继于","target":"event.1904.拉萨"}],"sources":[{"ref":"source.wiki.中英续订藏印条约"},{"ref":"source.《中外旧约章汇编》","page":"345"}],"tags":["西藏","英国","条约"]},{"id":"event.1901.新政上谕","type":"event","labels":{"zh-Hans":"清末新政上谕"},"time":{"kind":"interval","start":"1901-01-29","end":"1901-01-29","precision":"day"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"慈禧太后以光绪帝名义发布变法上谕，命大臣就朝章国故、吏治民生等条陈改革，清末新政开始。"},"category":"politics","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1901"]},{"id":"event.1901.督办政务处","type":"event","labels":{"zh-Hans":"督办政务处成立"},"time":{"kind":"interval","start":"1901-04","end":"1901-04","precision":"month"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清廷设督办政务处，由奕劻、荣禄等主持，统筹新政条陈与改革事务。"},"category":"politics","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1901"]},{"id":"event.1901.江楚会奏","type":"event","labels":{"zh-Hans":"江楚会奏三折"},"time":{"kind":"interval","start":"1901-07","end":"1901-07","precision":"month"},"space":{"points":[{"name":{"zh-Hans":"南京"},"coord":[118.79,32.05]}]},"summary":{"zh-Hans":"刘坤一、张之洞联衔上《江楚会奏变法三折》，提出兴学、练兵、整顿吏治等系统改革方案。"},"category":"politics","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1901","督抚"]},{"id":"event.1902.壬寅新政","type":"event","labels":{"zh-Hans":"壬寅新政：劝禁缠足与满汉通婚"},"time":{"kind":"interval","start":"1902-02","end":"1902-02","precision":"month"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清廷发布上谕劝禁缠足、允许满汉通婚，并整顿学堂、裁汰冗官，新政进入社会习俗层面。"},"category":"politics","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1902","社会"]},{"id":"event.1902.天津巡警","type":"event","labels":{"zh-Hans":"天津巡警创办"},"time":{"kind":"interval","start":"1902-08","end":"1902-08","precision":"month"},"space":{"points":[{"name":{"zh-Hans":"天津"},"coord":[117.2,39.13]}]},"summary":{"zh-Hans":"袁世凯在天津创办巡警，是中国近代警察制度的开端，后推广至京城与各省。"},"category":"politics","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1902","巡警"]},{"id":"event.1902.整顿学堂","type":"event","labels":{"zh-Hans":"整顿学堂与科举"},"time":{"kind":"interval","start":"1902","end":"1902","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清廷命整顿学堂、改书院为学堂，并递减科举取士名额，为新学制铺路。"},"category":"education","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1902","教育"]},{"id":"event.1903.商部","type":"event","labels":{"zh-Hans":"商部成立"},"time":{"kind":"interval","start":"1903-09","end":"1903-09","precision":"month"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清廷设商部，由载振主持，掌管工商业、铁路、矿务，是近代经济行政的开端。"},"category":"economy","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1903","商部"]},{"id":"event.1903.练兵处","type":"event","labels":{"zh-Hans":"练兵处成立"},"time":{"kind":"interval","start":"1903-12","end":"1903-12","precision":"month"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清廷设练兵处，奕劻、袁世凯、铁良主持，统一编练新军。"},"category":"war","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1903","军事"]},{"id":"event.1903.奖励公司章程","type":"event","labels":{"zh-Hans":"奖励公司章程颁布"},"time":{"kind":"interval","start":"1903","end":"1903","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清廷颁布奖励公司章程，按投资与办厂规模授予官衔，鼓励民间兴办实业。"},"category":"economy","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1903","实业"]},{"id":"event.1904.癸卯学制","type":"event","labels":{"zh-Hans":"癸卯学制颁布"},"time":{"kind":"interval","start":"1904-01","end":"1904-01","precision":"month"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清廷颁布《奏定学堂章程》（癸卯学制），建立从蒙养院到通儒院的近代学制。"},"category":"education","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1904","教育"]},{"id":"event.1904.营制饷章","type":"event","labels":{"zh-Hans":"新军营制饷章"},"time":{"kind":"interval","start":"1904","end":"1904","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清廷统一新军营制与饷章，编练三十六镇新军，北洋六镇最先成军。"},"category":"war","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1904","军事"]},{"id":"event.1904.修订法律馆","type":"event","labels":{"zh-Hans":"修订法律馆开馆"},"time":{"kind":"interval","start":"1904","end":"1904","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清廷设修订法律馆，沈家本、伍廷芳主持，起草新刑律、民律与诉讼法。"},"category":"law","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1904","法律"]},{"id":"event.1905.废科举","type":"event","labels":{"zh-Hans":"废科举"},"time":{"kind":"interval","start":"1905-09","end":"1905-09","precision":"month"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清廷诏停科举，自丙午科起各省岁科考试停止，一千三百年的科举制终结。"},"category":"education","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1905","科举"]},{"id":"event.1905.学部","type":"event","labels":{"zh-Hans":"学部成立"},"time":{"kind":"interval","start":"1905-12","end":"1905-12","precision":"month"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清廷设学部，统管全国学堂与教育行政，荣庆为首任尚书。"},"category":"education","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1905","教育"]},{"id":"event.1905.巡警部","type":"event","labels":{"zh-Hans":"巡警部成立"},"time":{"kind":"interval","start":"1905-10","end":"1905-10","precision":"month"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"清廷设巡警部，徐世昌主持，统管京师与各省警察事务。"},"category":"politics","sources":[{"ref":"source.《清末立宪运动史》"}],"tags":["新政","1905","巡警"]},{"id":"event