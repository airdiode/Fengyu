"source.国保名录"},{"ref":"source.web.惠通桥"}]}]},{"id":"route.nw-supply","type":"route","labels":{"zh-Hans":"西北国际交通线"},"aliases":[{"zh-Hans":"中苏西北交通线"}],"time":{"kind":"interval","start":"1937","end":"1941","precision":"year"},"space":{"lines":[{"geometry":{"type":"LineString","coordinates":[[80.42,44.2],[81.32,43.92],[82.9,44.6],[84.68,44.43],[87.62,43.79],[89.19,42.95],[93.51,42.83],[95.78,40.52],[98.49,39.73],[100.45,38.93],[103.83,36.06]]}}],"points":[{"name":{"zh-Hans":"霍尔果斯"},"coord":[80.42,44.2]},{"name":{"zh-Hans":"迪化"},"coord":[87.62,43.79]},{"name":{"zh-Hans":"哈密"},"coord":[93.51,42.83]},{"name":{"zh-Hans":"兰州"},"coord":[103.83,36.06]}]},"sources":[{"ref":"source.wiki.西北国际交通线"}],"summary":{"zh-Hans":"1937 年抗战全面爆发后开辟的陆路通道：苏联援华物资经霍尔果斯入境，走伊宁—迪化—哈密—兰州，再从兰州分运各战区。1937–1941 年间运进飞机、坦克、火炮与油料，是太平洋战争前中国最重要的外援通道；1941 年苏德战争爆发后基本停运。路线为示意线。"},"tags":["路线","抗日战争"]}]}