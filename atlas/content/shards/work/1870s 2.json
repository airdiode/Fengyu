{"key":"work/1870s","entities":[{"id":"work.pufa-zhanyi","type":"work","labels":{"zh-Hans":"《普法战纪》"},"aliases":[{"zh-Hans":"普法战纪"}],"medium":"other","creators":["person.x"],"time":{"kind":"interval","start":"1873","end":"1873","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"香港"},"coord":[114.17,22.3]}]},"summary":{"zh-Hans":"王韬据外国报纸与张宗良口译材料编成的纪事本末体战史，记 1870–1871 年普法战争，同治十二年（1873）由中华印务总局活字排印十四卷。书中分析法国战败之由与普鲁士强盛之理，问世后在中国、日本都引起轰动；1878 年日本军部颁行全国，成为其军方与知识界的必读书。后又有二十卷本传世。"},"metrics":[{"key":"volumes","name":{"zh-Hans":"卷数"},"unit":"卷","points":[{"year":1873,"value":14,"note":{"zh-Hans":"同治十二年中华印务总局活字排印十四卷"}}]}],"sources":[{"ref":"source.wiki.普法战纪"}],"tags":["文献","史书","洋务"]}]}