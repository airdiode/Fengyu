{"key":"place/1840s","entities":[{"id":"place.port.广州","type":"place","labels":{"zh-Hans":"广州"},"time":{"kind":"interval","start":"1842","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"广州"},"coord":[113.26,23.13]}]},"placeType":"port","port":{"open":1842,"kind":"treaty","treaty":"《南京条约》五口通商"},"sources":[{"ref":"source.《中外旧约章汇编》"}],"summary":{"zh-Hans":"1842 年约开商埠 · 五口之一，原为唯一对外通商口岸，开埠后十三行体制终结。"},"aliases":[{"zh-Hans":"五口通商"}]},{"id":"place.port.厦门","type":"place","labels":{"zh-Hans":"厦门"},"time":{"kind":"interval","start":"1842","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"厦门"},"coord":[118.09,24.48]}]},"placeType":"port","port":{"open":1842,"kind":"treaty","treaty":"《南京条约》五口通商"},"sources":[{"ref":"source.《中外旧约章汇编》"}],"summary":{"zh-Hans":"1842 年约开商埠 · 五口之一，闽南茶叶与劳工出洋的主要口岸。"}},{"id":"place.port.福州","type":"place","labels":{"zh-Hans":"福州"},"time":{"kind":"interval","start":"1842","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"福州"},"coord":[119.3,26.08]}]},"placeType":"port","port":{"open":1842,"kind":"treaty","treaty":"《南京条约》五口通商"},"sources":[{"ref":"source.《中外旧约章汇编》"}],"summary":{"zh-Hans":"1842 年约开商埠 · 五口之一，闽江下游茶市，后为福州船政局所在。"}},{"id":"place.port.宁波","type":"place","labels":{"zh-Hans":"宁波"},"time":{"kind":"interval","start":"1842","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"宁波"},"coord":[121.55,29.87]}]},"placeType":"port","port":{"open":1842,"kind":"treaty","treaty":"《南京条约》五口通商"},"sources":[{"ref":"source.《中外旧约章汇编》"}],"summary":{"zh-Hans":"1842 年约开商埠 · 五口之一，浙东贸易中心。"}},{"id":"place.port.上海","type":"place","labels":{"zh-Hans":"上海"},"time":{"kind":"interval","start":"1842","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23]}]},"placeType":"port","port":{"open":1842,"kind":"treaty","treaty":"《南京条约》五口通商"},"sources":[{"ref":"source.web.上海人口1935"},{"ref":"source.web.公用事业年报"}],"summary":{"zh-Hans":"1842 年约开商埠 · 五口之一，1843 年开埠后迅速取代广州，成为远东第一大港。"},"metrics":[{"key":"population","name":{"zh-Hans":"人口"},"unit":"人","points":[{"year":1935,"value":3490762,"note":{"zh-Hans":"公共租界 1,007,868、法租界 496,536、华界 1,986,358"}},{"year":1945,"value":3240000,"note":{"zh-Hans":"全市人口 324 万"}},{"year":1946,"value":3830000,"note":{"zh-Hans":"全市人口 383 万"}},{"year":1947,"value":4490000,"note":{"zh-Hans":"全市人口 449 万"}}]}]},{"id":"place.macau","type":"place","labels":{"zh-Hans":"澳门"},"time":{"kind":"interval","start":"1844","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"澳门"},"coord":[113.55,22.19]}]},"placeType":"city","summary":{"zh-Hans":"葡萄牙居留地。1844 年法国摄影师于勒·埃及尔在此拍下现存最早的中国影像之一。"},"sources":[{"ref":"source.web.最早中国影像"}],"tags":["地点","澳门"]},{"id":"place.山海关","type":"place","labels":{"zh-Hans":"山海关"},"aliases":[{"zh-Hans":"榆关"}],"placeType":"pass","time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"山海关"},"coord":[119.75,40.01]}]},"summary":{"zh-Hans":"长城东端第一关，扼辽西走廊与华北之间的咽喉，关内外的门户。1900 年八国联军在此驻兵；1922、1924 年两次直奉战争都在这一带决战；1933 年 1 月日军攻占榆关，长城抗战由此爆发；关外移民（闯关东）也多取道于此。"},"sources":[{"ref":"source.wiki.山海关"}],"tags":["关隘","东北"]},{"id":"place.古北口","type":"place","labels":{"zh-Hans":"古北口"},"placeType":"pass","time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"古北口"},"coord":[117.16,40.69]}]},"summary":{"zh-Hans":"长城要口之一，北平经此通往热河。1933 年 3 月长城抗战中，中央军第十七军与东北军在古北口与日军激战，伤亡惨重；此后日军由此进出热河与冀东。"},"sources":[{"ref":"source.wiki.古北口"}],"tags":["关隘","抗日战争"]},{"id":"place.潼关","type":"place","labels":{"zh-Hans":"潼关"},"placeType":"pass","time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"潼关"},"coord":[110.25,34.54]}]},"summary":{"zh-Hans":"关中门户，夹在黄河与秦岭之间，自古是由中原入陕的咽喉。1900 年慈禧西逃经此；抗战期间日军始终未能突破潼关—黄河防线，陕西全境得以保全。"},"sources":[{"ref":"source.wiki.潼关"}],"tags":["关隘"]},{"id":"place.嘉峪关","type":"place","labels":{"zh-Hans":"嘉峪关"},"placeType":"pass","time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"嘉峪关"},"coord":[98.29,39.8]}]},"summary":{"zh-Hans":"明长城西端关隘，河西走廊的西口，出关即入西域。1875–1878 年左宗棠西征以嘉峪关为后方基地；1881 年《伊犁条约》后，嘉峪关列为中俄通商孔道、设领事。"},"sources":[{"ref":"source.wiki.嘉峪关"}],"tags":["关隘","新疆"]},{"id":"place.张家口","type":"place","labels":{"zh-Hans":"张家口"},"aliases":[{"zh-Hans":"张垣"}],"placeType":"pass","time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"张家口"},"coord":[114.88,40.82]}]},"summary":{"zh-Hans":"居庸关外的口子，京绥铁路与张库大道（张家口—库伦—恰克图）的起点。1860 年代起是中俄陆路茶叶贸易的枢纽；1933 年冯玉祥在此组织察哈尔抗日同盟军；1937 年后为蒙疆政权所在，1945、1948 年两度成为国共争夺的要点。"},"sources":[{"ref":"source.wiki.张家口"}],"tags":["关隘","蒙古"]},{"id":"place.亚东","type":"place","labels":{"zh-Hans":"亚东"},"aliases":[{"zh-Hans":"春丕"}],"placeType":"pass","time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"亚东"},"coord":[88.9,27.48]}]},"summary":{"zh-Hans":"西藏与锡金（英属印度）之间的山口通道，海拔约 3000 米，是藏南最便捷的对外孔道。1888 年英军第一次侵藏、1904 年荣赫鹏率军经此入藏直抵拉萨；1893 年《中英藏印续约》开亚东为商埠，1904 年《拉萨条约》后又开江孜、噶大克。"},"sources":[{"ref":"source.wiki.亚东"}],"tags":["关隘","西藏"]},{"id":"place.dongsha","type":"place","labels":{"zh-Hans":"东沙群岛"},"time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"东沙群岛"},"coord":[116.72,20.7]}]},"placeType":"island","summary":{"zh-Hans":"南海诸岛中最北的一群，清属惠州府，1909 年粤督张人骏派舰勘查、设灯塔。"},"sources":[{"ref":"source.《南海诸岛位置图》（1947）"}],"tags":["南海","岛屿"]},{"id":"place.xisha","type":"place","labels":{"zh-Hans":"西沙群岛"},"time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"西沙群岛"},"coord":[112,16.5]}]},"placeType":"island","summary":{"zh-Hans":"古称千里长沙。1909 年广东水师提督李准率舰巡阅、鸣炮升旗，重申主权。"},"sources":[{"ref":"source.《南海诸岛位置图》（1947）"}],"tags":["南海","岛屿"]},{"id":"place.zhongsha","type":"place","labels":{"zh-Hans":"中沙群岛"},"time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"中沙群岛"},"coord":[114.3,15.5]}]},"placeType":"island","summary":{"zh-Hans":"古称万里石塘的一部分，多为水下环礁，只有黄岩岛等少数露出水面。"},"sources":[{"ref":"source.《南海诸岛位置图》（1947）"}],"tags":["南海","岛屿"]},{"id":"place.huangyan","type":"place","labels":{"zh-Hans":"黄岩岛"},"aliases":[{"zh-Hans":"民主礁"}],"time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"黄岩岛"},"coord":[117.75,15.15]}]},"placeType":"island","summary":{"zh-Hans":"中沙群岛中唯一露出水面的环礁，1935 年水陆地图审查委员会公布名称为「斯卡巴洛礁」，1947 年改称民主礁。"},"sources":[{"ref":"source.《南海诸岛位置图》（1947）"}],"tags":["南海","岛屿"]},{"id":"place.nansha","type":"place","labels":{"zh-Hans":"南沙群岛"},"time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"南沙群岛"},"coord":[114,10]}]},"placeType":"island","summary":{"zh-Hans":"南海诸岛中分布最广的一群。1946 年国民政府派「太平」「中业」等舰接收，立碑、升旗、测绘。"},"sources":[{"ref":"source.《南海诸岛位置图》（1947）"}],"tags":["南海","岛屿"]},{"id":"place.taipingdao","type":"place","labels":{"zh-Hans":"太平岛"},"time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"太平岛"},"coord":[114.36,10.38]}]},"placeType":"island","summary":{"zh-Hans":"南沙群岛中最大的自然岛。1946 年 12 月中国海军「太平」舰接收，岛因此得名。"},"sources":[{"ref":"source.《南海诸岛位置图》（1947）"}],"tags":["南海","岛屿"]},{"id":"place.diaoyu","type":"place","labels":{"zh-Hans":"钓鱼岛"},"aliases":[{"zh-Hans":"钓鱼台"}],"time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"钓鱼岛"},"coord":[123.47,25.74]}]},"placeType":"island","summary":{"zh-Hans":"明清使琉球录中记为「钓鱼屿」，属台湾附属岛屿。1895 年随台湾被日本占据。"},"sources":[{"ref":"source.《南海诸岛位置图》（1947）"}],"tags":["岛屿","东海"]},{"id":"place.penghu","type":"place","labels":{"zh-Hans":"澎湖列岛"},"time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"澎湖列岛"},"coord":[119.58,23.57]}]},"placeType":"island","summary":{"zh-Hans":"台湾海峡中的群岛，清设澎湖厅。《马关条约》与台湾同被割让，1945 年一同归还。"},"sources":[{"ref":"source.《南海诸岛位置图》（1947）"}],"tags":["岛屿","台湾"]},{"id":"place.昆明","type":"place","labels":{"zh-Hans":"昆明"},"aliases":[{"zh-Hans":"昆明市"},{"zh-Hans":"云南府"}],"placeType":"city","time":{"kind":"interval","start":"1840","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"昆明"},"coord":[102.71,25.05]}]},"summary":{"zh-Hans":"云南府城，1910 年滇越铁路通车后成为西南对外通道的起点。抗战时期是大后方重镇：国立西南联合大学迁此办学，中央防疫处在高峣村制出中国第一批临床级青霉素，滇缅公路与驼峰航线的物资由此转运。1945 年后成为「一二·一」运动的发生地。"},"sources":[{"ref":"source.wiki.昆明"}],"tags":["城市","西南","抗日战争"]}]}