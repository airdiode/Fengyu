{"key":"technology/1870s","entities":[{"id":"technology.rickshaw","type":"technology","labels":{"zh-Hans":"人力车","en":"Rickshaw"},"time":{"kind":"interval","start":"1874","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23]}]},"field":"transport","introducedFrom":"jp","firstAt":"place.port.上海","summary":{"zh-Hans":"1873 年法国商人米拉（Menard）从日本把人力车带到上海，1874 年正式营业；到 1914 年，仅公共租界就有 9,178 辆。"},"sources":[{"ref":"source.web.人力车"},{"ref":"source.web.上海人力车"},{"ref":"source.web.上海人力车"}],"tags":["技术","交通","城市"],"adoption":[{"place":"place.port.上海","year":1874,"stage":"introduced","note":{"zh-Hans":"米拉的公司正式营业"}},{"place":"place.port.上海","year":1913,"stage":"diffused","note":{"zh-Hans":"公共租界公用人力车 8,621 辆"}},{"place":"place.port.上海","year":1884,"stage":"introduced","note":{"zh-Hans":"公共租界捐照月均约 2,000 辆"}},{"place":"place.port.上海","year":1924,"stage":"diffused","note":{"zh-Hans":"公共租界捐照 13,411 辆，已与电车、汽车同为市内主要客运工具"}},{"place":"place.port.上海","year":1934,"stage":"diffused","note":{"zh-Hans":"全市约 23,306 辆、车主 4,814 户、车夫 78,630 人（市社会局调查）"}}],"metrics":[{"key":"licensed-rickshaws","name":{"zh-Hans":"公共租界公用人力车"},"unit":"辆","points":[{"year":1913,"value":8621},{"year":1914,"value":8718},{"year":1915,"value":8912},{"year":1917,"value":8000},{"year":1923,"value":8000}]},{"key":"rickshaw-licences","name":{"zh-Hans":"公共租界人力车捐照"},"unit":"辆","points":[{"year":1884,"value":2000},{"year":1909,"value":8471},{"year":1915,"value":8912},{"year":1924,"value":13411}]},{"key":"rickshaw-fleet","name":{"zh-Hans":"全市人力车"},"unit":"辆","points":[{"year":1933,"value":23335},{"year":1934,"value":23306}]},{"key":"rickshaw-pullers","name":{"zh-Hans":"人力车夫"},"unit":"人","points":[{"year":1934,"value":78630}]},{"key":"rickshaw-rent","name":{"zh-Hans":"车夫包月收入"},"unit":"元/月","points":[{"year":1928,"value":11,"note":{"zh-Hans":"包月车夫月入 11–16 元（《中国劳动年鉴》1928）"}}]}]},{"id":"technology.telegraph","type":"technology","labels":{"zh-Hans":"电报"},"time":{"kind":"interval","start":"1871","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23]}]},"summary":{"zh-Hans":"1871 年 6 月，丹商大北电报公司把香港—上海、长崎—上海两条水线引入上海，在南京路 12 号设报房通报，电报由此进入中国；1881 年底津沪电报线全线开放，是中国大陆第一条长途公众电报电路。资费按「路有远近、费有等差」：上海到苏州每字 1 角、镇江 1 角 1 分、济宁 1 角 3 分、天津 1 角 5 分——当时 1 角可买大米 16 斤，所以报务员会替客人精练字数。"},"tags":["技术","城市日常","通讯"],"sources":[{"ref":"source.web.电报入华"},{"ref":"source.web.大北电报"}],"adoption":[{"place":"place.port.上海","year":1871,"stage":"introduced","note":{"zh-Hans":"大北水线在南京路 12 号设报房通报"}},{"place":"place.port.上海","year":1881,"stage":"diffused","note":{"zh-Hans":"津沪电报线全线开放，沿线设电报局八处"}}],"metrics":[{"key":"telegram-fare-suzhou","name":{"zh-Hans":"电报费（上海—苏州）"},"unit":"元/字","points":[{"year":1881,"value":0.1}]},{"key":"telegram-fare-tianjin","name":{"zh-Hans":"电报费（上海—天津）"},"unit":"元/字","points":[{"year":1881,"value":0.15}]}]}]}