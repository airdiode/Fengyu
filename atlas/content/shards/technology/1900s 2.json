{"key":"technology/1900s","entities":[{"id":"technology.tram","type":"technology","labels":{"zh-Hans":"有轨电车","en":"Tram"},"time":{"kind":"interval","start":"1908","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.45,31.23]}]},"field":"transport","introducedFrom":"uk","firstAt":"place.port.上海","summary":{"zh-Hans":"1908 年 3 月 5 日，英商上海电车公司开通静安寺到外滩广东路的有轨电车，全程 6.04 公里，是上海第一条电车线路。"},"sources":[{"ref":"source.web.上海电车"},{"ref":"source.web.上海电车客流"},{"ref":"source.web.上海电车票价"}],"tags":["技术","交通","城市"],"adoption":[{"place":"place.port.上海","year":1908,"stage":"introduced","note":{"zh-Hans":"8 条线、65 辆车，静安寺—外滩首发"}},{"place":"place.port.上海","year":1909,"stage":"diffused","note":{"zh-Hans":"全年运客 2,725 万人次"}},{"place":"place.port.上海","year":1920,"stage":"diffused","note":{"zh-Hans":"头等、二等之外增设三等客票，每英里 1.86 枚铜元"}},{"place":"place.port.上海","year":1927,"stage":"diffused","note":{"zh-Hans":"全市 22 条线路，日均载客近 50 万人次"}}],"metrics":[{"key":"tramcars","name":{"zh-Hans":"有轨电车"},"unit":"辆","points":[{"year":1908,"value":65}]},{"key":"passengers","name":{"zh-Hans":"年运客量"},"unit":"万人次","points":[{"year":1909,"value":2725}]},{"key":"tram-fare-1st","name":{"zh-Hans":"头等票价（每段）"},"unit":"分（银元）","points":[{"year":1908,"value":3},{"year":1911,"value":2}]},{"key":"tram-fare-2nd","name":{"zh-Hans":"二等票价（每段）"},"unit":"分（银元）","points":[{"year":1908,"value":2},{"year":1911,"value":1}]},{"key":"tram-fare-3rd","name":{"zh-Hans":"三等票价"},"unit":"铜元/英里","points":[{"year":1920,"value":1.86},{"year":1937,"value":5.52}]},{"key":"tram-lines","name":{"zh-Hans":"有轨电车线路"},"unit":"条","points":[{"year":1908,"value":8},{"year":1927,"value":22}]},{"key":"tram-passengers-daily","name":{"zh-Hans":"日均载客"},"unit":"万人次","points":[{"year":1927,"value":50}]}]},{"id":"technology.aircraft","type":"technology","labels":{"zh-Hans":"飞机"},"field":"military","introducedFrom":"美国","firstAt":"place.port.广州","time":{"kind":"interval","start":"1909","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"广州"},"coord":[113.26,23.13]}]},"summary":{"zh-Hans":"1909 年 9 月 21 日，广东恩平人冯如在美国奥克兰驾自制「冯如 1 号」试飞，升空 4.5 米、飞行约 800 米，是中国人第一次动力载人飞行，美国报纸称他「东方的莱特」。1911 年 2 月他带两架飞机回国，在广州设广东飞行器公司。1913 年北洋政府在北京南苑办航空学校，从法国购入 12 架高德隆 G.4 双翼机，中国始有成建制的航空教育；此后飞机长期依赖进口，抗战时苏联、美国援助的机种先后成为主力。"},"adoption":[{"place":"place.port.广州","year":1911,"stage":"introduced","note":{"zh-Hans":"冯如带两架自制飞机回国，在广州设厂"}},{"place":"place.port.南京","year":1937,"stage":"diffused","note":{"zh-Hans":"抗战爆发后空军成为独立军种，苏、美援华机种为主力"}}],"sources":[{"ref":"source.wiki.冯如"},{"ref":"source.wiki.南苑航空学校"}],"tags":["技术","军事","航空"],"metrics":[{"key":"aircraft-imported","name":{"zh-Hans":"南苑购入"},"unit":"架","points":[{"year":1913,"value":12,"note":{"zh-Hans":"从法国购入高德隆 G.4 双翼机 12 架，供南苑航校使用"}}]}]}]}