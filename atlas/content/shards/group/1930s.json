{"key":"group/1930s","entities":[{"id":"group.red-army-1","type":"group","labels":{"zh-Hans":"红一方面军"},"time":{"kind":"interval","start":"1930","end":"1937","precision":"year"},"traits":["军事","土地革命","军队"],"summary":{"zh-Hans":"1930 年 8 月由红一军团与红三军团合编而成，通称中央红军，长期在赣南闽西活动；1934 年 10 月自中央苏区出发西移，1935 年到陕北。方面军下设军团，军团下设师，编制随战局屡次改编。"},"sources":[{"ref":"source.textbook-8a"}],"tags":["军事","土地革命"]},{"id":"group.red-army-2","type":"group","labels":{"zh-Hans":"红二方面军"},"time":{"kind":"interval","start":"1936","end":"1937","precision":"year"},"traits":["军事","土地革命","军队"],"summary":{"zh-Hans":"1936 年 7 月由红二、红六军团与红三十二军合编而成，此前长期在湘鄂川黔边活动；同年北上，1936 年 10 月在甘肃会宁、静宁一带与红一方面军会合。"},"sources":[{"ref":"source.textbook-8a"}],"tags":["军事","土地革命"]},{"id":"group.red-army-4","type":"group","labels":{"zh-Hans":"红四方面军"},"time":{"kind":"interval","start":"1931","end":"1937","precision":"year"},"traits":["军事","土地革命","军队"],"summary":{"zh-Hans":"1931 年 11 月在鄂豫皖苏区由红四军与红二十五军合编而成，同年主力转入川陕；1935 年参加北上，一部西渡黄河后组成西路军。方面军兵员多为鄂豫皖、川陕子弟，编制与一方面军大体相同。"},"sources":[{"ref":"source.textbook-8a"}],"tags":["军事","土地革命"]},{"id":"group.eighth-route-army","type":"group","labels":{"zh-Hans":"八路军"},"time":{"kind":"interval","start":"1937","end":"1947","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"延安"},"coord":[109.49,36.6]}]},"traits":["军事","抗战","军队"],"summary":{"zh-Hans":"1937 年 8 月由红军主力改编而成，初辖第一一五、一二〇、一二九三个师，设总指挥、副总指挥；抗战期间在华北敌后活动，1947 年改称中国人民解放军。"},"sources":[{"ref":"source.textbook-8a"}],"tags":["军事","抗日战争"]},{"id":"group.new-fourth-army","type":"group","labels":{"zh-Hans":"新四军"},"time":{"kind":"interval","start":"1937","end":"1947","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"盐城"},"coord":[120.16,33.35]}]},"traits":["军事","抗战","军队"],"summary":{"zh-Hans":"1937 年 10 月由南方八省红军和游击队改编而成，初设军长、副军长；1941 年初军部遭袭击后在苏北盐城重建，陈毅代军长、刘少奇任政治委员。抗战期间在华中活动，1947 年改称中国人民解放军。"},"sources":[{"ref":"source.textbook-8a"}],"tags":["军事","抗日战争"]}]}