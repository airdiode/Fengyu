{"key":"institution/1860s","entities":[{"id":"institution.总理衙门","type":"institution","labels":{"zh-Hans":"总理各国事务衙门"},"aliases":[{"zh-Hans":"总理衙门"},{"zh-Hans":"总署"}],"time":{"kind":"interval","start":"1861","end":"1901","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.9]}]},"sector":"politics","summary":{"zh-Hans":"1861 年 3 月设立，全称「总理各国事务衙门」，由恭亲王奕䜣主持，主管外交、通商、海关、洋务与派遣使节——清朝第一个近代意义的外交机构，但它始终是临时差遣性质，班列在六部之后。1901 年《辛丑条约》后改为外务部。"},"sources":[{"ref":"source.wiki.总理衙门"}],"tags":["外交","机构"]},{"id":"institution.jinling-jiqi","type":"institution","sector":"industry","labels":{"zh-Hans":"金陵机器制造局"},"time":{"kind":"interval","start":"1865","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"南京"},"coord":[118.793,32.014]}]},"summary":{"zh-Hans":"1865 年李鸿章在南京中华门外创办，是在苏州洋炮局基础上扩建的近代军工厂，与江南制造总局、福州船政局、天津机器局并称洋务四大兵工厂。民国后改称金陵兵工厂，抗战时西迁重庆，是当时中国最重要的轻武器生产基地之一。旧址今为晨光 1865 科技创意产业园，保留多栋清代厂房。 "},"visits":[{"kind":"site","name":{"zh-Hans":"金陵兵工厂旧址"},"address":{"zh-Hans":"江苏省南京市秦淮区 正学路 1 号（晨光 1865 创意产业园）"},"note":{"zh-Hans":"第七批国保（清至民国）。洋务四大兵工厂之一，现存清代与民国厂房十余栋，厂区已改成创意园，可自由走动看建筑外观，部分展馆另收费。"},"status":"extant","since":"1865","sources":[{"ref":"source.国保名录"}]}],"sources":[{"ref":"source.国保名录"}],"tags":["军工","洋务","南京"]},{"id":"institution.jiujiang-haiguan","type":"institution","sector":"finance","labels":{"zh-Hans":"九江海关"},"time":{"kind":"interval","start":"1861","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"九江"},"coord":[116.002,29.712]}]},"summary":{"zh-Hans":"1861 年《天津条约》后九江开埠设关，是长江中游最早的海关之一；姑塘分关设于鄱阳湖口，控扼赣江—鄱阳湖的水运咽喉，凡往来瓷茶木材的船只都要在此验关纳税。姑塘关一度「日有千帆」，是清代至民国江西最重要的水上税关。 "},"visits":[{"kind":"site","name":{"zh-Hans":"九江姑塘海关旧址"},"address":{"zh-Hans":"江西省九江市濂溪区 姑塘镇 鄱阳湖口"},"note":{"zh-Hans":"第八批国保（1902—1931 年）。鄱阳湖口水道的海关建筑，见证九江开埠后的水运税收；在姑塘镇湖边，交通偏、适合自驾。"},"status":"extant","since":"1902","sources":[{"ref":"source.国保名录"}]}],"sources":[{"ref":"source.国保名录"}],"tags":["海关","九江"]},{"id":"institution.tongwenguan","type":"institution","labels":{"zh-Hans":"京师同文馆"},"time":{"kind":"interval","start":"1862","end":"1902","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.42,39.92]}]},"sector":"education","successor":"institution.jingshi-daxuetang","summary":{"zh-Hans":"总理衙门奏设，培养译才，是近代第一所官办新式学堂；1902 年并入京师大学堂。"},"sources":[{"ref":"source.《中国近代教育史》"}],"tags":["机构","教育"]},{"id":"institution.jiangnan-zhizao","type":"institution","labels":{"zh-Hans":"江南制造总局"},"time":{"kind":"interval","start":"1865","end":"1932","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.49,31.19]}]},"sector":"industry","founders":["person.lihongzhang"],"summary":{"zh-Hans":"洋务派最大的近代军工厂，附设翻译馆，译印西书数百种。"},"sources":[{"ref":"source.web.江南制造局产量"},{"ref":"source.web.恬吉号"}],"tags":["机构","工业"],"visits":[{"kind":"site","name":{"zh-Hans":"江南制造总局旧址（今江南造船厂旧址）"},"address":{"zh-Hans":"上海市黄浦区原高昌庙一带（今江南造船厂旧址、世博浦西滨江片区）"},"note":{"zh-Hans":"市级文物保护单位（上海市保，名录作「江南制造总局旧址」，批次未注明；直辖市市级即省级）。上海市文物保护单位。保留 2 号船坞、指挥楼、飞机车间、西公务厅等原建筑；**只有 2 号船坞对外开放（09:00–17:00）**，其余不开放。厂区已整体搬迁长兴岛，原址成了滨江园区。"},"status":"extant","sources":[{"ref":"source.web.江南制造总局旧址"},{"ref":"source.省保名录"}]}],"metrics":[{"key":"rifles","name":{"zh-Hans":"制造步枪"},"unit":"支","points":[{"year":1894,"value":51285,"note":{"zh-Hans":"1867—1894 年累计"}}]},{"key":"cannons","name":{"zh-Hans":"制造火炮"},"unit":"门","points":[{"year":1894,"value":585,"note":{"zh-Hans":"1867—1894 年累计，含劈山炮 311 尊；1867—1904 年累计为 742 门"}}]},{"key":"ships","name":{"zh-Hans":"造舰船"},"unit":"艘","points":[{"year":1894,"value":8,"note":{"zh-Hans":"1867—1894 年"}}]},{"key":"steel","name":{"zh-Hans":"冶炼钢材"},"unit":"吨","points":[{"year":1894,"value":8075}]}]},{"id":"institution.fuzhou-chuanzheng","type":"institution","labels":{"zh-Hans":"福州船政学堂"},"time":{"kind":"interval","start":"1866","end":"1913","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"福州"},"coord":[119.45,26]}]},"sector":"education","founders":["person.zuozongtang"],"summary":{"zh-Hans":"左宗棠创办、沈葆桢主持，分前后学堂习造船与驾驶，严复、邓世昌皆出其门。"},"sources":[{"ref":"source.web.马尾船政文化"}],"tags":["机构","教育"],"visits":[{"kind":"site","name":{"zh-Hans":"船政学堂旧址（马尾）"},"address":{"zh-Hans":"福州市马尾区昭忠路一带（船政文化景区内）"},"note":{"zh-Hans":"属全国重点文物保护单位「福建船政建筑」（第五批）的组成部分（求是堂艺局/船政学堂旧址）。求是堂艺局（船政学堂）的原址区域，与船政文化博物馆、昭忠祠连成一片；严复、邓世昌、萨镇冰都从这里出来。"},"status":"rebuilt","sources":[{"ref":"source.web.船政博物馆"},{"ref":"source.国保名录"}]}],"metrics":[{"key":"ships","name":{"zh-Hans":"造船"},"unit":"艘","points":[{"year":1907,"value":44,"note":{"zh-Hans":"1868—1907 年累计；另有「40 余艘」一说"}}]},{"key":"tonnage","name":{"zh-Hans":"造船总吨位"},"unit":"吨","points":[{"year":1907,"value":57550,"note":{"zh-Hans":"占当时全国总产量的 82%"}}]},{"key":"graduates","name":{"zh-Hans":"船政学堂毕业生"},"unit":"人","points":[{"year":1907,"value":629,"note":{"zh-Hans":"40 多年毕业 510 名，连民国初期共 629 名；选送留学生 111 人"}}]}]},{"id":"institution.guangfangyanguan","type":"institution","labels":{"zh-Hans":"上海广方言馆"},"time":{"kind":"interval","start":"1863","end":"1905","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23]}]},"sector":"education","founders":["person.lihongzhang"],"summary":{"zh-Hans":"李鸿章奏设于上海，招文童习外国语文与算学，1869 年并入江南制造总局，与京师同文馆并称最早的官办外语学堂。"},"sources":[{"ref":"source.《中国近代教育史》"}],"tags":["机构","教育"]},{"id":"institution.fuzhou-chuanzhengju","type":"institution","labels":{"zh-Hans":"福州船政局"},"time":{"kind":"interval","start":"1866","end":"1907","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"福州"},"coord":[119.3,26.08]}]},"sector":"industry","summary":{"zh-Hans":"左宗棠、沈葆桢主持的近代舰船制造与船政教育机构，附设船政学堂。"},"sources":[{"ref":"source.《洋务运动史》"}],"tags":["机构","洋务"],"visits":[{"kind":"site","name":{"zh-Hans":"马尾船政文化景区（船政文化博物馆、船政学堂旧址）"},"address":{"zh-Hans":"福州市马尾区昭忠路、马限山一带"},"note":{"zh-Hans":"属全国重点文物保护单位「福建船政建筑」（第五批）的组成部分（船政文化景区含船政学堂、船政衙门等旧址）。船政局、船政学堂与福建水师都在这一片。今天能看：中国船政文化博物馆（昭忠路 7 号）、船政学堂旧址、昭忠祠、罗星塔；博物馆免费，9:00–12:00 / 13:30–17:00。"},"status":"rebuilt","sources":[{"ref":"source.web.船政博物馆"},{"ref":"source.国保名录"}]}]},{"id":"institution.anqing-junxiesuo","type":"institution","labels":{"zh-Hans":"安庆内军械所"},"time":{"kind":"interval","start":"1861","end":"1864","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"安庆"},"coord":[117.05,30.53]}]},"sector":"industry","summary":{"zh-Hans":"曾国藩创办的早期近代军械所，制造枪炮与蒸汽机，是洋务军事工业的先声。"},"sources":[{"ref":"source.《洋务运动史》"}],"tags":["机构","洋务"]},{"id":"institution.shanghai-yangpaoju","type":"institution","labels":{"zh-Hans":"上海洋炮局"},"time":{"kind":"interval","start":"1862","end":"1865","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23]}]},"sector":"industry","summary":{"zh-Hans":"李鸿章创办的洋炮局，后并入江南制造总局。"},"sources":[{"ref":"source.《洋务运动史》"}],"tags":["机构","洋务"]},{"id":"institution.jinling-jiqiju","type":"institution","labels":{"zh-Hans":"金陵机器局"},"time":{"kind":"interval","start":"1865","end":"1929","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"南京"},"coord":[118.79,32.05]}]},"sector":"industry","summary":{"zh-Hans":"李鸿章创办的金陵机器局，生产枪炮与弹药。"},"sources":[{"ref":"source.《洋务运动史》"}],"tags":["机构","洋务"]},{"id":"institution.tianjin-jiqiju","type":"institution","labels":{"zh-Hans":"天津机器局"},"time":{"kind":"interval","start":"1867","end":"1900","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"天津"},"coord":[117.2,39.13]}]},"sector":"industry","summary":{"zh-Hans":"崇厚创办、李鸿章接办的北方军火工业，生产枪炮、弹药与水雷。"},"sources":[{"ref":"source.《洋务运动史》"}],"tags":["机构","洋务"]},{"id":"institution.guangzhou-tongwenguan","type":"institution","labels":{"zh-Hans":"广州同文馆"},"time":{"kind":"interval","start":"1864","end":"1905","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"广州"},"coord":[113.26,23.13]}]},"sector":"education","summary":{"zh-Hans":"清廷在广州设立的同文馆，培养外语与洋务人才。"},"sources":[{"ref":"source.《洋务运动史》"}],"tags":["机构","洋务"]},{"id":"institution.dabe","type":"institution","labels":{"zh-Hans":"大北电报公司"},"time":{"kind":"interval","start":"1869","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23]}]},"sector":"press","summary":{"zh-Hans":"1869 年成立的丹麦大北电报公司，1871 年擅自把水线引入上海租界报房，4 月起收发沪港公众电报，是最早在华经营电报的外商之一；1882 年又开通电话业务。外滩的电报大楼即其产业，今为上海电信博物馆。"},"tags":["机构","通讯","城市日常"],"sources":[{"ref":"source.web.大北电报"}],"relations":[{"type":"founded","target":"technology.telegraph"}]},{"id":"institution.gongdongju-yiwuchu","type":"institution","labels":{"zh-Hans":"法租界公董局医务处"},"time":{"kind":"interval","start":"1862","end":"1943","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23]}]},"sector":"medical","summary":{"zh-Hans":"法租界公董局下设的卫生行政机构（后称公共卫生救济处），与公共租界工部局卫生处并列，管防疫、医院、菜场与食品检验，并按年公布生死统计。它留下的法租界华人死亡率与工部局那套口径不完全一致，比较时要注意：1934 年 11.1‰、1936 年 17.4‰，1937 年战事一起冲到 43.8‰。"},"tags":["机构","医疗","公共卫生"],"sources":[{"ref":"source.web.上海通志死亡率"}],"metrics":[{"key":"mortality-chinese","name":{"zh-Hans":"法租界华人死亡率"},"unit":"‰","points":[{"year":1934,"value":11.1},{"year":1935,"value":9},{"year":1936,"value":17.4},{"year":1937,"value":43.8,"note":{"zh-Hans":"淞沪战事之年"}},{"year":1942,"value":24.2}]}]}]}