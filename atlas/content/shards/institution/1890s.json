{"key":"institution/1890s","entities":[{"id":"institution.beijing-university","type":"institution","labels":{"zh-Hans":"北京大学"},"time":{"kind":"interval","start":"1898","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.4,39.92]}]},"summary":{"zh-Hans":"1912 年由京师大学堂改立；蔡元培 1917 年任校长，倡「思想自由、兼容并包」，1920 年首招女生。1930 年后蒋梦麟主校，抗战中与清华、南开合组西南联大。"},"sources":[{"ref":"source.《庚子赔款》"}],"tags":["机构","庚款","教育"],"sector":"education","visits":[{"kind":"site","name":{"zh-Hans":"北京大学红楼"},"address":{"zh-Hans":"北京市东城区五四大街 29 号"},"note":{"zh-Hans":"第一批国保（1918 年）。红楼是北大老校舍，五四运动的指挥部；今为北京新文化运动纪念馆，免费、需预约。"},"status":"extant","sources":[{"ref":"source.国保名录"}],"since":"1918"},{"kind":"site","name":{"zh-Hans":"北京大学地质学馆旧址"},"address":{"zh-Hans":"北京市东城区 沙滩北街 15 号院"},"note":{"zh-Hans":"第七批国保（1935 年）。原为清乾隆时傅恒家庙（松公府），1931 年北大购得，1934 年梁思成、林徽因设计改建为地质学馆，1935 年 8 月建成，是我国最早引进西方现代主义风格的建筑之一。今为中国社科院法学所使用，不对外开放，院门外可看外立面。"},"status":"extant","since":"1934","sources":[{"ref":"source.国保名录"},{"ref":"source.web.北大地址学馆"}]}]},{"id":"institution.zhongxi-nvshu","type":"institution","labels":{"zh-Hans":"中西女塾","en":"McTyeire School"},"time":{"kind":"interval","start":"1892","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23]}]},"sector":"education","summary":{"zh-Hans":"美国监理会传教士林乐知 1892 年在上海创办，海淑德（Laura Haygood）任首任校长；英文校名 McTyeire School 纪念墨梯主教，后改中西女子中学。"},"sources":[{"ref":"source.web.中西女塾"}],"tags":["机构","教育","女性"],"visits":[{"kind":"site","name":{"zh-Hans":"中西女塾旧址"},"address":{"zh-Hans":"上海市长宁区江苏路 155 号（今上海市第三女子中学）"},"note":{"zh-Hans":"上海市长宁区文物保护单位（区保，名录作「中西女塾旧址」）。中西女塾 1892 年由美国监理会创办于汉口路，1920 年代迁江苏路现址，建筑群今为市三女中使用。"},"status":"extant","sources":[{"ref":"source.市县级名录"}]}]},{"id":"institution.hanyang-tiechang","type":"institution","labels":{"zh-Hans":"汉阳铁厂"},"time":{"kind":"interval","start":"1890","end":"1924","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"汉阳"},"coord":[114.25,30.56]}]},"sector":"industry","founders":["person.zhangzhidong"],"summary":{"zh-Hans":"张之洞筹办，中国第一个近代钢铁联合企业，后与萍乡煤矿、大冶铁矿合组汉冶萍公司。"},"sources":[{"ref":"source.web.汉阳铁厂产量"},{"ref":"source.web.简明汉阳区志"},{"ref":"source.wiki.汉阳铁厂"}],"tags":["机构","钢铁"],"relations":[{"type":"merged_into","target":"institution.hanyeping","note":{"zh-Hans":"1908 年与萍乡煤矿、大冶铁矿合并为汉冶萍公司"}}],"visits":[{"kind":"site","name":{"zh-Hans":"汉冶萍煤铁厂矿旧址"},"address":{"zh-Hans":"湖北省黄石市 铁山区、西塞山区一带"},"note":{"zh-Hans":"第六批国保（1890—1948 年）。汉阳铁厂、大冶铁矿、萍乡煤矿合组汉冶萍公司后，冶炼与采掘主体在黄石；今存高炉基座、铁矿天坑与运矿铁路遗迹，是洋务重工业最完整的一处现场。"},"status":"extant","sources":[{"ref":"source.国保名录"}],"since":"1890"}],"metrics":[{"key":"cost","name":{"zh-Hans":"建厂费用"},"unit":"万两","points":[{"year":1893,"value":500,"note":{"zh-Hans":"原表数，未改"}}]},{"key":"pig-iron","name":{"zh-Hans":"生铁产量"},"unit":"万吨","points":[{"year":1902,"value":1.58,"note":{"zh-Hans":"15,825 吨"}},{"year":1910,"value":11.94,"note":{"zh-Hans":"119,396 吨"}}]},{"key":"steel","name":{"zh-Hans":"钢产量"},"unit":"万吨","points":[{"year":1908,"value":2.26,"note":{"zh-Hans":"22,626 吨"}},{"year":1910,"value":5.01,"note":{"zh-Hans":"50,113 吨"}}]},{"key":"total-iron","name":{"zh-Hans":"累计产铁"},"unit":"万吨","points":[{"year":1924,"value":221.4,"note":{"zh-Hans":"创建后 31 年合计"}}]},{"key":"total-steel","name":{"zh-Hans":"累计产钢"},"unit":"万吨","points":[{"year":1924,"value":62.1,"note":{"zh-Hans":"创建后 31 年合计"}}]}]},{"id":"institution.beiyang-daxuetang","type":"institution","labels":{"zh-Hans":"北洋大学堂"},"time":{"kind":"interval","start":"1895","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"天津"},"coord":[117.16,39.17]}]},"sector":"education","summary":{"zh-Hans":"盛宣怀奏设于天津，中国第一所近代大学，设律例、矿务、工程等科。"},"sources":[{"ref":"source.《中国近代教育史》"}],"tags":["机构","教育"],"visits":[{"kind":"site","name":{"zh-Hans":"北洋大学堂旧址"},"address":{"zh-Hans":"天津市红桥区 光荣道 2 号（河北工业大学红桥校区东院）"},"note":{"zh-Hans":"第七批国保（1902 年）。北洋大学堂 1902 年迁西沽武库新校址，现存南大楼、北大楼与团城三处早期建筑；今为河北工业大学校园，可入校看建筑，能否进楼以学校管理为准。"},"status":"extant","since":"1902","sources":[{"ref":"source.国保名录"},{"ref":"source.web.天津文物游径"}]}]},{"id":"institution.nanyang-gongxue","type":"institution","labels":{"zh-Hans":"南洋公学"},"time":{"kind":"interval","start":"1896","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.43,31.2]}]},"sector":"education","summary":{"zh-Hans":"盛宣怀创办于上海，设师范院、外院、中院、上院，交通大学前身之一。"},"sources":[{"ref":"source.《中国近代教育史》"}],"tags":["机构","教育"]},{"id":"institution.shangwu-yinshuguan","type":"institution","labels":{"zh-Hans":"商务印书馆"},"time":{"kind":"interval","start":"1897","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.48,31.24]}]},"sector":"press","summary":{"zh-Hans":"夏瑞芳等创办，以教科书与辞书起家，兼印《东方杂志》，是近代最大的出版机构。"},"sources":[{"ref":"source.《中国报学史》"}],"tags":["机构","出版"],"visits":[{"kind":"site","name":{"zh-Hans":"商务印书馆第五印刷所旧址"},"address":{"zh-Hans":"上海市静安区天通庵路 190 号"},"note":{"zh-Hans":"区级文物保护单位（上海市静安区）。商务 1907 年在宝山路建总厂，1932 年「一·二八」被日军炸毁；天通庵路这处印刷所是仅存的商务旧址单体建筑，静安区不可移动文物，现作展览与纪念空间。宝山路 449 弄—584 号一带是当年的总厂范围。"},"status":"extant","sources":[{"ref":"source.web.商务印书馆旧址"},{"ref":"source.web.商务印书馆第五印刷所"}]}]},{"id":"institution.jingshi-daxuetang","type":"institution","labels":{"zh-Hans":"京师大学堂"},"time":{"kind":"interval","start":"1898","end":"1912","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"北京"},"coord":[116.41,39.93]}]},"sector":"education","predecessor":"institution.tongwenguan","summary":{"zh-Hans":"戊戌变法中创办，中国近代第一所国立综合大学，1912 年改北京大学。"},"sources":[{"ref":"source.《中国近代教育史》"}],"tags":["机构","教育"],"visits":[{"kind":"site","name":{"zh-Hans":"京师大学堂旧址（和嘉公主府）"},"address":{"zh-Hans":"北京市东城区沙滩后街 55、59 号"},"note":{"zh-Hans":"市级文物保护单位（北京市保第四批，名录作「京师大学堂建筑遗存」；分科大学旧址另是第六批国保）。原和嘉公主府，1898 年辟为京师大学堂（北大前身），现为人民教育出版社、高等教育出版社院。**不对外开放**——只能在门口看看「公主大殿」与数学系小楼的外墙；去之前别抱进院子的期待。"},"status":"extant","sources":[{"ref":"source.web.京师大学堂旧址"},{"ref":"source.国保名录"}]},{"kind":"site","name":{"zh-Hans":"京师大学堂分科大学旧址"},"address":{"zh-Hans":"北京市东城区 安德里北街 21 号（西院，黄寺以南）"},"note":{"zh-Hans":"第六批国保（清）。1908 年动工、1910 年建成，日本建筑师真水英夫设计，现存文科楼、经科楼等五栋二层灰砖楼；辛亥革命一起工程中断，民国时改作兵营，大学堂始终没用上这处校舍。今在院区内，不对外开放，一般只能在门外看外观，以现场为准。"},"status":"extant","since":"1910","sources":[{"ref":"source.国保名录"},{"ref":"source.web.京师大学堂分科大学"}]}]},{"id":"institution.tongshang-yinhang","type":"institution","labels":{"zh-Hans":"中国通商银行"},"time":{"kind":"interval","start":"1897","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.49,31.23]}]},"sector":"finance","summary":{"zh-Hans":"盛宣怀创办，中国人自办的第一家近代银行，有发行钞票之权。"},"sources":[{"ref":"source.《中国近代金融史》"}],"tags":["机构","金融"]},{"id":"institution.dasheng-shachang","type":"institution","labels":{"zh-Hans":"大生纱厂"},"time":{"kind":"interval","start":"1895","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"南通"},"coord":[120.86,32.01]}]},"sector":"industry","founders":["person.zhangjian"],"summary":{"zh-Hans":"张謇在通州筹办，1899 年开车，是近代最有影响的民营棉纺企业，也是「实业救国」的样板。"},"sources":[{"ref":"source.《中国近代工业史》"}],"tags":["机构","工业"],"visits":[{"kind":"site","name":{"zh-Hans":"南通大生第三纺织公司旧址"},"address":{"zh-Hans":"江苏省南通市海门区 三厂镇一带"},"note":{"zh-Hans":"第七批国保（1919 年）。张謇大生系统在海门三厂镇办的第三纺织厂，厂房与钟楼尚存；与南通唐闸的大生纱厂一厂两点，可串成「张謇实业线」。"},"status":"extant","sources":[{"ref":"source.国保名录"}],"since":"1919"}]},{"id":"institution.jingzheng-nvxue","type":"institution","labels":{"zh-Hans":"经正女学"},"time":{"kind":"interval","start":"1898","end":"1900","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.46,31.22]}]},"sector":"education","summary":{"zh-Hans":"经元善等在上海创办，是国人自办的第一所女学堂，课程兼及中西，1900 年因故停办。"},"sources":[{"ref":"source.《中国近代教育史》"}],"tags":["机构","教育","女性"]},{"id":"institution.shiwu-bao","type":"institution","labels":{"zh-Hans":"《时务报》"},"time":{"kind":"interval","start":"1896","end":"1898","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.48,31.24]}]},"sector":"press","summary":{"zh-Hans":"汪康年经理、梁启超主笔，以「变法图存」立论，是戊戌时期影响最大的报刊，1898 年改为官报。"},"sources":[{"ref":"source.《中国报学史》"}],"tags":["机构","报刊"]},{"id":"institution.hubei-qiangpaochang","type":"institution","labels":{"zh-Hans":"湖北枪炮厂"},"time":{"kind":"interval","start":"1890","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"武汉"},"coord":[114.3,30.59]}]},"sector":"industry","summary":{"zh-Hans":"张之洞创办的湖北枪炮厂，后发展为汉阳兵工厂。"},"sources":[{"ref":"source.《洋务运动史》"}],"tags":["机构","洋务"]},{"id":"institution.hubei-zhibuju","type":"institution","labels":{"zh-Hans":"湖北织布局"},"time":{"kind":"interval","start":"1890","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"武昌"},"coord":[114.31,30.55]}]},"sector":"industry","summary":{"zh-Hans":"张之洞创办的湖北织布局，是华中近代纺织工业的开端。"},"sources":[{"ref":"source.《洋务运动史》"}],"tags":["机构","洋务"]},{"id":"institution.ziqiang-xuetang","type":"institution","labels":{"zh-Hans":"自强学堂"},"time":{"kind":"interval","start":"1893","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"武昌"},"coord":[114.31,30.55]}]},"sector":"education","summary":{"zh-Hans":"张之洞创办的自强学堂，武汉大学的前身之一。"},"sources":[{"ref":"source.《洋务运动史》"}],"tags":["机构","洋务"]},{"id":"institution.xinwenbao","type":"institution","labels":{"zh-Hans":"《新闻报》馆"},"time":{"kind":"interval","start":"1893","end":"1949","precision":"year"},"space":{"points":[{"name":{"zh-Hans":"上海"},"coord":[121.47,31.23]}]},"sector":"press","summary":{"zh-Hans":"《新闻报》1893 年创刊于上海，与《申报》同为近代上海发行量最大的两家报纸；1930 年代一度日销 20 万份，超过《申报》的 15 万份。两报馆同处望平街一带，是上海报业的中心。"},"tags":["机构","报刊","城市日常"],"sources":[{"ref":"source.web.新闻报发行量"},{"ref":"source.web.报海旧闻"}],"metrics":[{"key":"retail-price-yuan","name":{"zh-Hans":"每份零售价"},"unit":"元/份","points":[{"year":1935,"value":0.036,"note":{"zh-Hans":"与《申报》同价，日出八至九张"}}]}]}]}